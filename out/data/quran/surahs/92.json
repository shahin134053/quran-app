{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","banglaName":"আল-লায়ল","banglaTranslation":"রজনী / রাত","revelationType":"Meccan","ayahs":[{"number":6059,"numberInSurah":1,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","translation":"শপথ রাত্রির, যখন সে আচ্ছন্ন করে,","transliteration":"Wallaili izaa yaghshaa"},{"number":6060,"numberInSurah":2,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","translation":"শপথ দিনের, যখন সে আলোকিত হয়","transliteration":"Wannahaari izaa tajalla"},{"number":6061,"numberInSurah":3,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","translation":"এবং তাঁর, যিনি নর ও নারী সৃষ্টি করেছেন,","transliteration":"Wa maa khalaqaz zakara wal unthaa"},{"number":6062,"numberInSurah":4,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","translation":"নিশ্চয় তোমাদের কর্ম প্রচেষ্টা বিভিন্ন ধরনের।","transliteration":"Inna sa'yakum lashattaa"},{"number":6063,"numberInSurah":5,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","translation":"অতএব, যে দান করে এবং খোদাভীরু হয়,","transliteration":"Fa ammaa man a'taa wattaqaa"},{"number":6064,"numberInSurah":6,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","translation":"এবং উত্তম বিষয়কে সত্য মনে করে,","transliteration":"Wa saddaqa bil husnaa"},{"number":6065,"numberInSurah":7,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","translation":"আমি তাকে সুখের বিষয়ের জন্যে সহজ পথ দান করব।","transliteration":"Fasanu yassiruhoo lilyusraa"},{"number":6066,"numberInSurah":8,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","translation":"আর যে কৃপণতা করে ও বেপরওয়া হয়","transliteration":"Wa ammaa mam bakhila wastaghnaa"},{"number":6067,"numberInSurah":9,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","translation":"এবং উত্তম বিষয়কে মিথ্যা মনে করে,","transliteration":"Wa kazzaba bil husnaa"},{"number":6068,"numberInSurah":10,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","translation":"আমি তাকে কষ্টের বিষয়ের জন্যে সহজ পথ দান করব।","transliteration":"Fasanu yassiruhoo lil'usraa"},{"number":6069,"numberInSurah":11,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","translation":"যখন সে অধঃপতিত হবে, তখন তার সম্পদ তার কোনই কাজে আসবে না।","transliteration":"Wa maa yughnee 'anhu maaluhooo izaa taraddaa"},{"number":6070,"numberInSurah":12,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","translation":"আমার দায়িত্ব পথ প্রদর্শন করা।","transliteration":"Inna 'alainaa lal hudaa"},{"number":6071,"numberInSurah":13,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","translation":"আর আমি মালিক ইহকালের ও পরকালের।","transliteration":"Wa inna lanaa lal Aakhirata wal oolaa"},{"number":6072,"numberInSurah":14,"juz":30,"page":595,"hizbQuarter":238,"sajda":false,"text":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","translation":"অতএব, আমি তোমাদেরকে প্রজ্বলিত অগ্নি সম্পর্কে সতর্ক করে দিয়েছি।","transliteration":"Fa anzartukum naaran talazzaa"},{"number":6073,"numberInSurah":15,"juz":30,"page":596,"hizbQuarter":238,"sajda":false,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","translation":"এতে নিতান্ত হতভাগ্য ব্যক্তিই প্রবেশ করবে,","transliteration":"Laa yaslaahaaa illal ashqaa"},{"number":6074,"numberInSurah":16,"juz":30,"page":596,"hizbQuarter":238,"sajda":false,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","translation":"যে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।","transliteration":"Allazee kazzaba wa tawallaa"},{"number":6075,"numberInSurah":17,"juz":30,"page":596,"hizbQuarter":238,"sajda":false,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","translation":"এ থেকে দূরে রাখা হবে খোদাভীরু ব্যক্তিকে,","transliteration":"Wa sa yujannnabuhal atqaa"},{"number":6076,"numberInSurah":18,"juz":30,"page":596,"hizbQuarter":238,"sajda":false,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","translation":"যে আত্নশুদ্ধির জন্যে তার ধন-সম্পদ দান করে।","transliteration":"Allazee yu'tee maalahoo yatazakkaa"},{"number":6077,"numberInSurah":19,"juz":30,"page":596,"hizbQuarter":238,"sajda":false,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","translation":"এবং তার উপর কারও কোন প্রতিদানযোগ্য অনুগ্রহ থাকে না।","transliteration":"Wa maa li ahadin 'indahoo min ni'matin tujzaaa"},{"number":6078,"numberInSurah":20,"juz":30,"page":596,"hizbQuarter":238,"sajda":false,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","translation":"তার মহান পালনকর্তার সন্তুষ্টি অন্বেষণ ব্যতীত।","transliteration":"Illab tighaaa'a wajhi rabbihil a 'laa"},{"number":6079,"numberInSurah":21,"juz":30,"page":596,"hizbQuarter":238,"sajda":false,"text":"وَلَسَوْفَ يَرْضَىٰ","translation":"সে সত্বরই সন্তুষ্টি লাভ করবে।","transliteration":"Wa lasawfa yardaa"}]}