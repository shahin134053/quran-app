{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","banglaName":"আত-তাকবীর","banglaTranslation":"সূর্য কিরণহীন হওয়া","revelationType":"Meccan","ayahs":[{"number":5801,"numberInSurah":1,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","translation":"যখন সূর্য আলোহীন হয়ে যাবে,","transliteration":"Izash shamsu kuwwirat"},{"number":5802,"numberInSurah":2,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","translation":"যখন নক্ষত্র মলিন হয়ে যাবে,","transliteration":"Wa izan nujoomun kadarat"},{"number":5803,"numberInSurah":3,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","translation":"যখন পর্বতমালা অপসারিত হবে,","transliteration":"Wa izal jibaalu suyyirat"},{"number":5804,"numberInSurah":4,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","translation":"যখন দশ মাসের গর্ভবতী উষ্ট্রীসমূহ উপেক্ষিত হবে;","transliteration":"Wa izal 'ishaaru 'uttilat"},{"number":5805,"numberInSurah":5,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","translation":"যখন বন্য পশুরা একত্রিত হয়ে যাবে,","transliteration":"Wa izal wuhooshu hushirat"},{"number":5806,"numberInSurah":6,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","translation":"যখন সমুদ্রকে উত্তাল করে তোলা হবে,","transliteration":"Wa izal bihaaru sujjirat"},{"number":5807,"numberInSurah":7,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","translation":"যখন আত্মাসমূহকে যুগল করা হবে,","transliteration":"Wa izan nufoosu zuwwijat"},{"number":5808,"numberInSurah":8,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","translation":"যখন জীবন্ত প্রোথিত কন্যাকে জিজ্ঞেস করা হবে,","transliteration":"Wa izal maw'oodatu su'ilat"},{"number":5809,"numberInSurah":9,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","translation":"কি অপরাধে তাকে হত্য করা হল?","transliteration":"Bi ayyi zambin qutilat"},{"number":5810,"numberInSurah":10,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","translation":"যখন আমলনামা খোলা হবে,","transliteration":"Wa izas suhufu nushirat"},{"number":5811,"numberInSurah":11,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","translation":"যখন আকাশের আবরণ অপসারিত হবে,","transliteration":"Wa izas samaaa'u kushitat"},{"number":5812,"numberInSurah":12,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","translation":"যখন জাহান্নামের অগ্নি প্রজ্বলিত করা হবে","transliteration":"Wa izal jaheemu su'-'irat"},{"number":5813,"numberInSurah":13,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","translation":"এবং যখন জান্নাত সন্নিকটবর্তী হবে,","transliteration":"Wa izal jannatu uzlifat"},{"number":5814,"numberInSurah":14,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","translation":"তখন প্রত্যেকেই জেনে নিবে সে কি উপস্থিত করেছে।","transliteration":"'Alimat nafsum maaa ahdarat"},{"number":5815,"numberInSurah":15,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","translation":"আমি শপথ করি যেসব নক্ষত্রগুলো পশ্চাতে সরে যায়।","transliteration":"Falaaa uqsimu bil khunnas"},{"number":5816,"numberInSurah":16,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","translation":"চলমান হয় ও অদৃশ্য হয়,","transliteration":"Al jawaaril kunnas"},{"number":5817,"numberInSurah":17,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","translation":"শপথ নিশাবসান ও","transliteration":"Wallaili izaa 'as'as"},{"number":5818,"numberInSurah":18,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","translation":"প্রভাত আগমন কালের,","transliteration":"Wassubhi izaa tanaffas"},{"number":5819,"numberInSurah":19,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","translation":"নিশ্চয় কোরআন সম্মানিত রসূলের আনীত বাণী,","transliteration":"Innahoo laqawlu rasoolin kareem"},{"number":5820,"numberInSurah":20,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","translation":"যিনি শক্তিশালী, আরশের মালিকের নিকট মর্যাদাশালী,","transliteration":"Zee quwwatin 'inda zil 'arshi makeen"},{"number":5821,"numberInSurah":21,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","translation":"সবার মান্যবর, সেখানকার বিশ্বাসভাজন।","transliteration":"Mutaa'in samma ameen"},{"number":5822,"numberInSurah":22,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","translation":"এবং তোমাদের সাথী পাগল নন।","transliteration":"Wa maa saahibukum bimajnoon"},{"number":5823,"numberInSurah":23,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","translation":"তিনি সেই ফেরেশতাকে প্রকাশ্য দিগন্তে দেখেছেন।","transliteration":"Wa laqad ra aahu bilufuqil mubeen"},{"number":5824,"numberInSurah":24,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","translation":"তিনি অদৃশ্য বিষয় বলতে কৃপনতা করেন না।","transliteration":"Wa maa huwa 'alal ghaibi bidaneen"},{"number":5825,"numberInSurah":25,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","translation":"এটা বিতাড়িত শয়তানের উক্তি নয়।","transliteration":"Wa maa huwa biqawli shaitaanir rajeem"},{"number":5826,"numberInSurah":26,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"فَأَيْنَ تَذْهَبُونَ","translation":"অতএব, তোমরা কোথায় যাচ্ছ?","transliteration":"Fa ayna tazhaboon"},{"number":5827,"numberInSurah":27,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","translation":"এটা তো কেবল বিশ্বাবাসীদের জন্যে উপদেশ,","transliteration":"In huwa illaa zikrul lil'aalameen"},{"number":5828,"numberInSurah":28,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","translation":"তার জন্যে, যে তোমাদের মধ্যে সোজা চলতে চায়।","transliteration":"Liman shaaa'a minkum ai yastaqeem"},{"number":5829,"numberInSurah":29,"juz":30,"page":586,"hizbQuarter":234,"sajda":false,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","translation":"তোমরা আল্লাহ রাব্বুল আলামীনের অভিপ্রায়ের বাইরে অন্য কিছুই ইচ্ছা করতে পার না।","transliteration":"Wa maa tashaaa'oona illaaa ai yashaaa 'al laahu Rabbul 'Aalameen"}]}