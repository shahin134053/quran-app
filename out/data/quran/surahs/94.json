{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","banglaName":"আশ-শারহ","banglaTranslation":"বক্ষ প্রশস্তকরণ","revelationType":"Meccan","ayahs":[{"number":6091,"numberInSurah":1,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","translation":"আমি কি আপনার বক্ষ উম্মুক্ত করে দেইনি?","transliteration":"Alam nashrah laka sadrak"},{"number":6092,"numberInSurah":2,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","translation":"আমি লাঘব করেছি আপনার বোঝা,","transliteration":"Wa wa d'ana 'anka wizrak"},{"number":6093,"numberInSurah":3,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","translation":"যা ছিল আপনার জন্যে অতিশয় দুঃসহ।","transliteration":"Allazee anqada zahrak"},{"number":6094,"numberInSurah":4,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","translation":"আমি আপনার আলোচনাকে সমুচ্চ করেছি।","transliteration":"Wa raf 'ana laka zikrak"},{"number":6095,"numberInSurah":5,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"فَإِنَّ ��َعَ ٱلْعُسْرِ يُسْرًا","translation":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","transliteration":"Fa inna ma'al usri yusra"},{"number":6096,"numberInSurah":6,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","translation":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","transliteration":"Inna ma'al 'usri yusra"},{"number":6097,"numberInSurah":7,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","translation":"অতএব, যখন অবসর পান পরিশ্রম করুন।","transliteration":"Fa iza faragh ta fansab"},{"number":6098,"numberInSurah":8,"juz":30,"page":596,"hizbQuarter":239,"sajda":false,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","translation":"এবং আপনার পালনকর্তার প্রতি মনোনিবেশ করুন।","transliteration":"Wa ilaa rabbika far ghab"}]}