{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","banglaName":"আল-মুরসালাত","banglaTranslation":"প্রেরিত বাতাস","revelationType":"Meccan","ayahs":[{"number":5623,"numberInSurah":1,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا","translation":"কল্যাণের জন্যে প্রেরিত বায়ুর শপথ,","transliteration":"Wal mursalaati'urfaa"},{"number":5624,"numberInSurah":2,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","translation":"সজোরে প্রবাহিত ঝটিকার শপথ,","transliteration":"Fal'aasifaati 'asfaa"},{"number":5625,"numberInSurah":3,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","translation":"মেঘবিস্তৃতকারী বায়ুর শপথ","transliteration":"Wannaashiraati nashraa"},{"number":5626,"numberInSurah":4,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","translation":"মেঘপুঞ্জ বিতরণকারী বায়ুর শপথ এবং","transliteration":"Falfaariqaati farqaa"},{"number":5627,"numberInSurah":5,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","translation":"ওহী নিয়ে অবতরণকারী ফেরেশতাগণের শপথ-","transliteration":"Falmulqiyaati zikra"},{"number":5628,"numberInSurah":6,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"عُذْرًا أَوْ نُذْرًا","translation":"ওযর-আপত্তির অবকাশ না রাখার জন্যে অথবা সতর্ক করার জন্যে।","transliteration":"'Uzran aw nuzraa"},{"number":5629,"numberInSurah":7,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","translation":"নিশ্চয়ই তোমাদেরকে প্রদত্ত ওয়াদা বাস্তবায়িত হবে।","transliteration":"Innamaa too'adoona lawaaqi'"},{"number":5630,"numberInSurah":8,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","translation":"অতঃপর যখন নক্ষত্রসমুহ নির্বাপিত হবে,","transliteration":"Fa izam nujoomu tumisat"},{"number":5631,"numberInSurah":9,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","translation":"যখন আকাশ ছিদ্রযুক্ত হবে,","transliteration":"Wa izas samaaa'u furijat"},{"number":5632,"numberInSurah":10,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","translation":"যখন পর্বতমালাকে উড়িয়ে দেয়া হবে এবং","transliteration":"Wa izal jibaalu nusifat"},{"number":5633,"numberInSurah":11,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","translation":"যখন রসূলগণের একত্রিত হওয়ার সময় নিরূপিত হবে,","transliteration":"Wa izar Rusulu uqqitat"},{"number":5634,"numberInSurah":12,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ","translation":"এসব বিষয় কোন দিবসের জন্যে স্থগিত রাখা হয়েছে?","transliteration":"Li ayyi yawmin ujjilat"},{"number":5635,"numberInSurah":13,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"لِيَوْمِ ٱلْفَصْلِ","translation":"বিচার দিবসের জন্য।","transliteration":"Li yawmil Fasl"},{"number":5636,"numberInSurah":14,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","translation":"আপনি জানেন বিচার দিবস কি?","transliteration":"Wa maaa adraaka maa yawmul fasl"},{"number":5637,"numberInSurah":15,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailuny yawma 'izillilmukazzibeen"},{"number":5638,"numberInSurah":16,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","translation":"আমি কি পূর্ববর্তীদেরকে ধ্বংস করিনি?","transliteration":"Alam nuhlikil awwaleen"},{"number":5639,"numberInSurah":17,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","translation":"অতঃপর তাদের পশ্চাতে প্রেরণ করব পরবর্তীদেরকে।","transliteration":"Summa nutbi'uhumul aakhireen"},{"number":5640,"numberInSurah":18,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","translation":"অপরাধীদের সাথে আমি এরূপই করে থাকি।","transliteration":"Kazzlika naf'alu bilmujrimeen"},{"number":5641,"numberInSurah":19,"juz":29,"page":580,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailunw yawma 'izil lil mukazzibeen"},{"number":5642,"numberInSurah":20,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","translation":"আমি কি তোমাদেরকে তুচ্ছ পানি থেকে সৃষ্টি করিনি?","transliteration":"Alam nakhlukkum mimmaaa'im maheen"},{"number":5643,"numberInSurah":21,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","translation":"অতঃপর আমি তা রেখেছি এক সংরক্ষিত আধারে,","transliteration":"Faja'alnaahu fee qaraarim makeen"},{"number":5644,"numberInSurah":22,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","translation":"এক নির্দিষ্টকাল পর্যন্ত,","transliteration":"Illaa qadrim ma'loom"},{"number":5645,"numberInSurah":23,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","translation":"অতঃপর আমি পরিমিত আকারে সৃষ্টি করেছি, আমি কত সক্ষম স্রষ্টা?","transliteration":"Faqadarnaa fani'mal qaadiroon"},{"number":5646,"numberInSurah":24,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailuny yawma 'izil lilmukazzibeen"},{"number":5647,"numberInSurah":25,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","translation":"আমি কি পৃথিবীকে সৃষ্টি করিনি ধারণকারিণীরূপে,","transliteration":"Alam naj'alil arda kifaataa"},{"number":5648,"numberInSurah":26,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"أَحْيَآءًۭ