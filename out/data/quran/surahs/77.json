,{"number":5656,"numberInSurah":34,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailuny yawma 'izil lilmukazibeen"},{"number":5657,"numberInSurah":35,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","translation":"এটা এমন দিন, যেদিন কেউ কথা বলবে না।","transliteration":"Haazaa yawmu laa uantiqoon"},{"number":5658,"numberInSurah":36,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","translation":"এবং কাউকে তওবা করার অনুমতি দেয়া হবে না।","transliteration":"Wa laa yu'zanu lahum fa ya'taziroon"},{"number":5659,"numberInSurah":37,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailunw yawma 'izil lilmukazzibeen"},{"number":5660,"numberInSurah":38,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","translation":"এটা বিচার দিবস, আমি তোমাদেরকে এবং তোমাদের পূর্ববর্তীদেরকে একত্রিত করেছি।","transliteration":"Haaza yawmul fasli jama 'naakum wal awwaleen"},{"number":5661,"numberInSurah":39,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","translation":"অতএব, তোমাদের কোন অপকৌশল থাকলে তা প্রয়োগ কর আমার কাছে।","transliteration":"Fa in kaana lakum kaidun fakeedoon"},{"number":5662,"numberInSurah":40,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailuny yawma'izil lilmukazzibeen"},{"number":5663,"numberInSurah":41,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","translation":"নিশ্চয় খোদাভীরুরা থাকবে ছায়ায় এবং প্রস্রবণসমূহে-","transliteration":"Innal muttaqeena fee zilaalinw wa 'uyoon"},{"number":5664,"numberInSurah":42,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","translation":"এবং তাদের বাঞ্ছিত ফল-মূলের মধ্যে।","transliteration":"Wa fawaakiha mimmaa yastahoon"},{"number":5665,"numberInSurah":43,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","translation":"বলা হবেঃ তোমরা যা করতে তার বিনিময়ে তৃপ্তির সাথে পানাহার কর।","transliteration":"Kuloo washraboo haneee 'am bimaa kuntum ta'maloon"},{"number":5666,"numberInSurah":44,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":"এভাবেই আমি সৎকর্মশীলদেরকে পুরস্কৃত করে থাকি।","transliteration":"Innaa kazaalika najzil muhsineen"},{"number":5667,"numberInSurah":45,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailuny yawma 'izil lilmuzkazzibeen"},{"number":5668,"numberInSurah":46,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","translation":"কাফেরগণ, তোমরা কিছুদিন খেয়ে নাও এবং ভোগ করে নাও। তোমরা তো অপরাধী।","transliteration":"Kuloo wa tamatta'oo qaleelan innakum mujrimoon"},{"number":5669,"numberInSurah":47,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারো��কারীদের দুর্ভোগ হবে।","transliteration":"Wailunny yawma 'izil lilmukazzibeen"},{"number":5670,"numberInSurah":48,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","translation":"যখন তাদেরকে বলা হয়, নত হও, তখন তারা নত হয় না।","transliteration":"Wa izaa qeela lahumur ka'oo aa yarka'oon"},{"number":5671,"numberInSurah":49,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।","transliteration":"Wailunny yawma 'izil lilmukazzibeen"},{"number":5672,"numberInSurah":50,"juz":29,"page":581,"hizbQuarter":232,"sajda":false,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","translation":"এখন কোন কথায় তারা এরপর বিশ্বাস স্থাপন করবে?","transliteration":"Fabi ayyi hadeesim ba'dahoo yu'minoon"}]}