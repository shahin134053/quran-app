{"number":1,"name":"سُورَةُ ٱلْفَاتِحَةِ","englishName":"Al-Faatiha","englishNameTranslation":"The Opening","banglaName":"আল-ফাতিহা","banglaTranslation":"সূচনা / আরম্ভ","revelationType":"Meccan","ayahs":[{"number":1,"numberInSurah":1,"juz":1,"page":1,"hizbQuarter":1,"sajda":false,"text":"﻿بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","translation":"শুরু করছি আল্লাহর নামে যিনি পরম করুণাময়, অতি দয়ালু।","transliteration":"Bismillaahir Rahmaanir Raheem"},{"number":2,"numberInSurah":2,"juz":1,"page":1,"hizbQuarter":1,"sajda":false,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","translation":"যাবতীয় প্রশংসা আল্লাহ তাআলার যিনি সকল সৃষ্টি জগতের পালনকর্তা।","transliteration":"Alhamdu lillaahi Rabbil 'aalameen"},{"number":3,"numberInSurah":3,"juz":1,"page":1,"hizbQuarter":1,"sajda":false,"text":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","translation":"যিনি নিতান্ত মেহেরবান ও দয়ালু।","transliteration":"Ar-Rahmaanir-Raheem"},{"number":4,"numberInSurah":4,"juz":1,"page":1,"hizbQuarter":1,"sajda":false,"text":"مَٰلِكِ يَوْمِ ٱلدِّينِ","translation":"যিনি বিচার দিনের মালিক।","transliteration":"Maaliki Yawmid-Deen"},{"number":5,"numberInSurah":5,"juz":1,"page":1,"hizbQuarter":1,"sajda":false,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","translation":"আমরা একমাত্র তোমারই ইবাদত করি এবং শুধুমাত্র তোমারই সাহায্য প্রার্থনা করি।","transliteration":"Iyyaaka na'budu wa lyyaaka nasta'een"},{"number":6,"numberInSurah":6,"juz":1,"page":1,"hizbQuarter":1,"sajda":false,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","translation":"আমাদেরকে সরল পথ দেখাও,","transliteration":"Ihdinas-Siraatal-Mustaqeem"},{"number":7,"numberInSurah":7,"juz":1,"page":1,"hizbQuarter":1,"sajda":false,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","translation":"সে সমস্ত লোকের পথ, যাদেরকে তুমি নেয়ামত দান করেছ। তাদের পথ নয়, যাদের প্রতি তোমার গজব নাযিল হয়েছে এবং যারা পথভ্রষ্ট হয়েছে।","transliteration":"Siraatal-lazeena an'amta 'alaihim ghayril-maghdoobi 'alaihim wa lad-daaalleen"}]}