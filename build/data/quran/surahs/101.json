{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","banglaName":"আল-ক্বারি'আহ","banglaTranslation":"মহা বিপর্যয়","revelationType":"Meccan","ayahs":[{"number":6158,"numberInSurah":1,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","translation":"করাঘাতকারী,","transliteration":"Al qaari'ah"},{"number":6159,"numberInSurah":2,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"مَا ٱلْقَارِعَةُ","translation":"করাঘাতকারী কি?","transliteration":"Mal qaariah"},{"number":6160,"numberInSurah":3,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","translation":"করাঘাতকারী সম্পর্কে আপনি কি জানেন ?","transliteration":"Wa maa adraaka mal qaari'ah"},{"number":6161,"numberInSurah":4,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","translation":"যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত","transliteration":"Yauma ya koonun naasu kal farashil mabthooth"},{"number":6162,"numberInSurah":5,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","translation":"এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।","transliteration":"Wa ta koonul jibalu kal 'ihnil manfoosh"},{"number":6163,"numberInSurah":6,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","translation":"অতএব যার পাল্লা ভারী হবে,","transliteration":"Fa-amma man thaqulat mawa zeenuh"},{"number":6164,"numberInSurah":7,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","translation":"সে সুখীজীবন যাপন করবে।","transliteration":"Fahuwa fee 'ishatir raadiyah"},{"number":6165,"numberInSurah":8,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","translation":"আর যার পাল্লা হালকা হবে,","transliteration":"Wa amma man khaffat mawa zeenuh"},{"number":6166,"numberInSurah":9,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","translation":"তার ঠিকানা হবে হাবিয়া।","transliteration":"Fa-ummuhu haawiyah"},{"number":6167,"numberInSurah":10,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","translation":"আপনি জানেন তা কি?","transliteration":"Wa maa adraaka maa hiyah"},{"number":6168,"numberInSurah":11,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"نَارٌ حَامِيَةٌۢ","translation":"প্রজ্জ্বলিত অগ্নি!","transliteration":"Naarun hamiyah"}]}