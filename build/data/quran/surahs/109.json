{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","banglaName":"আল-কাফিরুন","banglaTranslation":"কাফির সম্প্রদায়","revelationType":"Meccan","ayahs":[{"number":6208,"numberInSurah":1,"juz":30,"page":603,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","translation":"বলুন, হে কাফেরকূল,","transliteration":"Qul yaa-ai yuhal kaafiroon"},{"number":6209,"numberInSurah":2,"juz":30,"page":603,"hizbQuarter":240,"sajda":false,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","translation":"আমি এবাদত করিনা, তোমরা যার এবাদত কর।","transliteration":"Laa a'budu ma t'abudoon"},{"number":6210,"numberInSurah":3,"juz":30,"page":603,"hizbQuarter":240,"sajda":false,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","translation":"এবং তোমরাও এবাদতকারী নও, যার এবাদত আমি করি","transliteration":"Wa laa antum 'aabidoona maa a'bud"},{"number":6211,"numberInSurah":4,"juz":30,"page":603,"hizbQuarter":240,"sajda":false,"text":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","translation":"এবং আমি এবাদতকারী নই, যার এবাদত তোমরা কর।","transliteration":"Wa laa ana 'abidum maa 'abattum"},{"number":6212,"numberInSurah":5,"juz":30,"page":603,"hizbQuarter":240,"sajda":false,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","translation":"তোমরা এবাদতকারী নও, যার এবাদত আমি করি।","transliteration":"Wa laa antum 'aabidoona ma a'bud"},{"number":6213,"numberInSurah":6,"juz":30,"page":603,"hizbQuarter":240,"sajda":false,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","translation":"তোমাদের কর্ম ও কর্মফল তোমাদের জন্যে এবং আমার কর্ম ও কর্মফল আমার জন্যে।","transliteration":"Lakum deenukum wa liya deen."}]}