{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","banglaName":"আন-নাস","banglaTranslation":"মানবজাতি","revelationType":"Meccan","ayahs":[{"number":6231,"numberInSurah":1,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার,","transliteration":"Qul a'uzu birabbin naas"},{"number":6232,"numberInSurah":2,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"مَلِكِ ٱلنَّاسِ","translation":"মানুষের অধিপতির,","transliteration":"Malikin naas"},{"number":6233,"numberInSurah":3,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"إِلَٰهِ ٱلنَّاسِ","translation":"মানুষের মা’বুদের","transliteration":"Ilaahin naas"},{"number":6234,"numberInSurah":4,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translation":"তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে,","transliteration":"Min sharril was waasil khannaas"},{"number":6235,"numberInSurah":5,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translation":"যে কুমন্ত্রণা দেয় মানুষের অন্তরে","transliteration":"Al lazee yuwas wisu fee sudoorin naas"},{"number":6236,"numberInSurah":6,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translation":"জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।","transliteration":"Minal jinnati wan naas"}]}