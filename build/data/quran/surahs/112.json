{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","banglaName":"আল-ইখলাস","banglaTranslation":"একনিষ্ঠতা / একত্ববাদ","revelationType":"Meccan","ayahs":[{"number":6222,"numberInSurah":1,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"বলুন, তিনি আল্লাহ, এক,","transliteration":"Qul huwal laahu ahad"},{"number":6223,"numberInSurah":2,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"ٱللَّهُ ٱلصَّمَدُ","translation":"আল্লাহ অমুখাপেক্ষী,","transliteration":"Allah hus-samad"},{"number":6224,"numberInSurah":3,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি","transliteration":"Lam yalid wa lam yoolad"},{"number":6225,"numberInSurah":4,"juz":30,"page":604,"hizbQuarter":240,"sajda":false,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"এবং তার সমতুল্য কেউ নেই।","transliteration":"Wa lam yakul-lahu kufuwan ahad"}]}