{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","banglaName":"আত-তাকাসুর","banglaTranslation":"প্রাচুর্যের মোহ","revelationType":"Meccan","ayahs":[{"number":6169,"numberInSurah":1,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"প্রাচুর্যের লালসা তোমাদেরকে গাফেল রাখে,","transliteration":"Al haaku mut takathur"},{"number":6170,"numberInSurah":2,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","translation":"এমনকি, তোমরা কবরস্থানে পৌছে যাও।","transliteration":"Hatta zurtumul-maqaabir"},{"number":6171,"numberInSurah":3,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","translation":"এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।","transliteration":"Kalla sawfa ta'lamoon"},{"number":6172,"numberInSurah":4,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","translation":"অতঃপর এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।","transliteration":"Thumma kalla sawfa ta'lamoon"},{"number":6173,"numberInSurah":5,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","translation":"কখনই নয়; যদি তোমরা নিশ্চিত জানতে।","transliteration":"Kalla law ta'lamoona 'ilmal yaqeen"},{"number":6174,"numberInSurah":6,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","translation":"তোমরা অবশ্যই জাহান্নাম দেখবে,","transliteration":"Latara-wun nal jaheem"},{"number":6175,"numberInSurah":7,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","translation":"অতঃপর তোমরা তা অবশ্যই দেখবে দিব্য প্রত্যয়ে,","transliteration":"Thumma latara wunnaha 'ainal yaqeen"},{"number":6176,"numberInSurah":8,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"এরপর অবশ্যই সেদিন তোমরা নেয়ামত সম্পর্কে জিজ্ঞাসিত হবে।","transliteration":"Thumma latus alunna yauma-izin 'anin na'eem"}]}