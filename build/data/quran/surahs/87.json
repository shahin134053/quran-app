{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","banglaName":"আল-আ'লা","banglaTranslation":"সর্বোচ্চ মহান","revelationType":"Meccan","ayahs":[{"number":5949,"numberInSurah":1,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","translation":"আপনি আপনার মহান পালনকর্তার নামের পবিত্রতা বর্ণনা করুন","transliteration":"Sabbihisma Rabbikal A'laa"},{"number":5950,"numberInSurah":2,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","translation":"যিনি সৃষ্টি করেছেন ও সুবিন্যস্ত করেছেন।","transliteration":"Allazee khalaqa fasawwaa"},{"number":5951,"numberInSurah":3,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","translation":"এবং যিনি সুপরিমিত করেছেন ও পথ প্রদর্শন করেছেন","transliteration":"Wallazee qaddara fahadaa"},{"number":5952,"numberInSurah":4,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","translation":"এবং যিনি তৃণাদি উৎপন্ন করেছেন,","transliteration":"Wallazeee akhrajal mar'aa"},{"number":5953,"numberInSurah":5,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","translation":"অতঃপর করেছেন তাকে কাল আবর্জনা।","transliteration":"Faja'alahoo ghusaaa'an ahwaa"},{"number":5954,"numberInSurah":6,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","translation":"আমি আপনাকে পাঠ করাতে থাকব, ফলে আপনি বিস্মৃত হবেন না","transliteration":"Sanuqri'uka falaa tansaaa"},{"number":5955,"numberInSurah":7,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","translation":"আল্লাহ যা ইচ্ছা করেন তা ব্যতীত। নিশ্চয় তিনি জানেন প্রকাশ্য ও গোপন বিষয়।","transliteration":"Illaa maa shaaa'al laah; innahoo ya'lamul jahra wa maa yakhfaa"},{"number":5956,"numberInSurah":8,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","translation":"আমি আপনার জন্যে সহজ শরীয়ত সহজতর করে দেবো।","transliteration":"Wa nu-yassiruka lilyusraa"},{"number":5957,"numberInSurah":9,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","translation":"উপদেশ ফলপ্রসূ হলে উপদেশ দান করুন,","transliteration":"Fazakkir in nafa'atizzikraa"},{"number":5958,"numberInSurah":10,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","translation":"যে ভয় করে, সে উপদেশ গ্রহণ করবে,","transliteration":"Sa yazzakkaru maiyakhshaa"},{"number":5959,"numberInSurah":11,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","translation":"আর যে, হতভাগা, সে তা উপেক্ষা করবে,","transliteration":"Wa yatajannabuhal ashqaa"},{"number":5960,"numberInSurah":12,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","translation":"সে মহা-অগ্নিতে প্রবেশ করবে।","transliteration":"Allazee yaslan Naaral kubraa"},{"number":5961,"numberInSurah":13,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","translation":"অতঃপর সেখানে সে মরবেও না, জীবিতও থাকবে না।","transliteration":"Summa laa yamootu feehaa wa laa yahyaa"},{"number":5962,"numberInSurah":14,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","translation":"নিশ্চয় সাফল্য লাভ করবে সে, যে শুদ্ধ হয়","transliteration":"Qad aflaha man tazakkaa"},{"number":5963,"numberInSurah":15,"juz":30,"page":591,"hizbQuarter":237,"sajda":false,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","translation":"এবং তার পালনকর্তার নাম স্মরণ করে, অতঃপর নামায আদায় করে।","transliteration":"Wa zakaras ma Rabbihee fasallaa"},{"number":5964,"numberInSurah":16,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"বস্তুতঃ তোমরা পার্থিব জীবনকে অগ্রাধিকার দাও,","transliteration":"Bal tu'siroonal hayaatad dunyaa"},{"number":5965,"numberInSurah":17,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","translation":"অথচ পরকালের জীবন উৎকৃষ্ট ও স্থায়ী।","transliteration":"Wal Aakhiratu khairunw wa abqaa"},{"number":5966,"numberInSurah":18,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","translation":"এটা লিখিত রয়েছে পূর্ববতী কিতাবসমূহে;","transliteration":"Inna haazaa lafis suhu fil oolaa"},{"number":5967,"numberInSurah":19,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","translation":"ইব্রাহীম ও মূসার কিতাবসমূহে।","transliteration":"Suhufi Ibraaheema wa Moosaa"}]}