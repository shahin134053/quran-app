{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","englishNameTranslation":"Almsgiving","banglaName":"আল-মা'উন","banglaTranslation":"নিত্যপ্রয়োজনীয় সাহায্য","revelationType":"Meccan","ayahs":[{"number":6198,"numberInSurah":1,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"আপনি কি দেখেছেন তাকে, যে বিচারদিবসকে মিথ্যা বলে?","transliteration":"Ara-aital lazee yu kazzibu bid deen"},{"number":6199,"numberInSurah":2,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"সে সেই ব্যক্তি, যে এতীমকে গলা ধাক্কা দেয়","transliteration":"Fa zaalikal lazi yadu'ul-yateem"},{"number":6200,"numberInSurah":3,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"এবং মিসকীনকে অন্ন দিতে উৎসাহিত করে না।","transliteration":"Wa la ya huddu 'alaa ta'amil miskeen"},{"number":6201,"numberInSurah":4,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","translation":"অতএব দুর্ভোগ সেসব নামাযীর,","transliteration":"Fa wai lul-lil mu salleen"},{"number":6202,"numberInSurah":5,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"যারা তাদের নামায সম্বন্ধে বে-খবর;","transliteration":"Al lazeena hum 'an salaatihim sahoon"},{"number":6203,"numberInSurah":6,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"যারা তা লোক-দেখানোর জন্য করে","transliteration":"Al lazeena hum yuraa-oon"},{"number":6204,"numberInSurah":7,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"এবং নিত্য ব্যবহার্য্য বস্তু অন্যকে দেয় না।","transliteration":"Wa yamna'oonal ma'oon"}]}