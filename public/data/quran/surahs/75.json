{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","banglaName":"আল-ক্বিয়ামাহ","banglaTranslation":"পুনরুত্থান দিবস","revelationType":"Meccan","ayahs":[{"number":5552,"numberInSurah":1,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","translation":"আমি শপথ করি কেয়ামত দিবসের,","transliteration":"Laaa uqsimu bi yawmil qiyaamah"},{"number":5553,"numberInSurah":2,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","translation":"আরও শপথ করি সেই মনের, যে নিজেকে ধিক্কার দেয়-","transliteration":"Wa laaa uqsimu bin nafsil lawwaamah"},{"number":5554,"numberInSurah":3,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","translation":"মানুষ কি মনে করে যে আমি তার অস্থিসমূহ একত্রিত করব না?","transliteration":"Ayahsabul insaanu al lan najm'a 'izaamah"},{"number":5555,"numberInSurah":4,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","translation":"পরন্ত আমি তার অংগুলিগুলো পর্যন্ত সঠিকভাবে সন্নিবেশিত করতে সক্ষম।","transliteration":"Balaa qaadireena 'alaaa an nusawwiya banaanah"},{"number":5556,"numberInSurah":5,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","translation":"বরং মানুষ তার ভবিষ্যত জীবনেও ধৃষ্টতা করতে চায়","transliteration":"Bal yureedul insaanu liyafjura amaamah"},{"number":5557,"numberInSurah":6,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","translation":"সে প্রশ্ন করে-কেয়ামত দিবস কবে?","transliteration":"Yas'alu ayyyaana yawmul qiyaamah"},{"number":5558,"numberInSurah":7,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","translation":"যখন দৃষ্টি চমকে যাবে,","transliteration":"Fa izaa bariqal basar"},{"number":5559,"numberInSurah":8,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"وَخَسَفَ ٱلْقَمَرُ","translation":"চন্দ্র জ্যোতিহীন হয়ে যাবে।","transliteration":"We khasafal qamar"},{"number":5560,"numberInSurah":9,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","translation":"এবং সূর্য ও চন্দ্রকে একত্রিত করা হবে-","transliteration":"Wa jumi'ash shamusu wal qamar"},{"number":5561,"numberInSurah":10,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","translation":"সে দিন মানুষ বলবেঃ পলায়নের জায়গা কোথায় ?","transliteration":"Yaqoolul insaanu yaw ma 'izin aynal mafarr"},{"number":5562,"numberInSurah":11,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"كَلَّا لَا وَزَرَ","translation":"না কোথাও আশ্রয়স্থল নেই।","transliteration":"Kallaa laa wazar"},{"number":5563,"numberInSurah":12,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","translation":"আপনার পালনকর্তার কাছেই সেদিন ঠাঁই হবে।","transliteration":"Ilaa rabbika yawma 'izinil mustaqarr"},{"number":5564,"numberInSurah":13,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","translation":"সেদিন মানুষকে অবহিত করা হবে সে যা সামনে প্রেরণ করেছে ও পশ্চাতে ছেড়ে দিয়েছে।","transliteration":"Yunabba 'ul insaanu yawma 'izim bimaa qaddama wa akhkhar"},{"number":5565,"numberInSurah":14,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ","translation":"বরং মানুষ নিজেই তার নিজের সম্পর্কে চক্ষুমান।","transliteration":"Balil insaanu 'alaa nafsihee baseerah"},{"number":5566,"numberInSurah":15,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","translation":"যদিও সে তার অজুহাত পেশ করতে চাইবে।","transliteration":"Wa law alqaa ma'aazeerah"},{"number":5567,"numberInSurah":16,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","translation":"তাড়াতাড়ি শিখে নেয়ার জন্যে আপনি দ্রুত ওহী আবৃত্তি করবেন না।","transliteration":"Laa tuharrik bihee lisaa naka lita'jala bih"},{"number":5568,"numberInSurah":17,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","translation":"এর সংরক্ষণ ও পাঠ আমারই দায়িত্ব।","transliteration":"Inna 'alainaa jam'ahoo wa qur aanah"},{"number":5569,"numberInSurah":18,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","translation":"অতঃপর আমি যখন তা পাঠ করি, তখন আপনি সেই পাঠের অনুসরণ করুন।","transliteration":"Fa izaa qaraanaahu fattabi' qur aanah"},{"number":5570,"numberInSurah":19,"juz":29,"page":577,"hizbQuarter":231,"sajda":false,"text":"ثُمَّ إِنَّ عَلَيْنَ�� بَيَانَهُۥ","translation":"এরপর বিশদ বর্ণনা আমারই দায়িত্ব।","transliteration":"Summa inna 'alainaa bayaanah"},{"number":5571,"numberInSurah":20,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","translation":"কখনও না, বরং তোমরা পার্থিব জীবনকে ভালবাস","transliteration":"Kallaa bal tuhibboonal 'aajilah"},{"number":5572,"numberInSurah":21,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"وَتَذَرُونَ ٱلْءَاخِرَةَ","translation":"এবং পরকালকে উপেক্ষা কর।","transliteration":"Wa tazaroonal Aakhirah"},{"number":5573,"numberInSurah":22,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ","translation":"সেদিন অনেক মুখমন্ডল উজ্জ্বল হবে।","transliteration":"Wujoohuny yawma 'izin naadirah"},{"number":5574,"numberInSurah":23,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌۭ","translation":"তারা তার পালনকর্তার দিকে তাকিয়ে থাকবে।","transliteration":"Ilaa rabbihaa naazirah"},{"number":5575,"numberInSurah":24,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ","translation":"আর অনেক মুখমন্ডল সেদিন উদাস হয়ে পড়বে।","transliteration":"Wa wujoohuny yawma 'izim baasirah"},{"number":5576,"numberInSurah":25,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ","translation":"তারা ধারণা করবে যে, তাদের সাথে কোমর-ভাঙ্গা আচরণ করা হবে।","transliteration":"Tazunnu any yuf'ala bihaa faaqirah"},{"number":5577,"numberInSurah":26,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","translation":"কখনও না, যখন প্রাণ কন্ঠাগত হবে।","transliteration":"Kallaaa izaa balaghatit taraaqee"},{"number":5578,"numberInSurah":27,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"وَقِيلَ مَنْ ۜ رَاقٍۢ","translation":"এবং বলা হবে, কে ঝাড়বে","transliteration":"Wa qeela man raaq"},{"number":5579,"numberInSurah":28,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","translation":"এবং সে মনে করবে যে, বিদায়ের ক্ষণ এসে গেছে।","transliteration":"Wa zanna annahul firaaq"},{"number":5580,"numberInSurah":29,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","translation":"এবং গোছা গোছার সাথে জড়িত হয়ে যাবে।","transliteration":"Waltaffatis saaqu bissaaq"},{"number":5581,"numberInSurah":30,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","translation":"সেদিন, আপনার পালনকর্তার নিকট সবকিছু নীত হবে।","transliteration":"Ilaa rabbika yawma'izinil masaaq"},{"number":5582,"numberInSurah":31,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","translation":"সে বিশ্বাস করেনি এবং নামায পড়েনি;","transliteration":"Falaa saddaqa wa laa sallaa"},{"number":5583,"numberInSurah":32,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","translation":"পরন্ত মিথ্যারোপ করেছে ও পৃষ্ঠ প্রদর্শন করেছে।","transliteration":"Wa laakin kazzaba wa tawalla"},{"number":5584,"numberInSurah":33,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","translation":"অতঃপর সে দম্ভভরে পরিবার-পরিজনের নিকট ফিরে গিয়েছে।","transliteration":"Summa zahaba ilaaa ahlihee yatamatta"},{"number":5585,"numberInSurah":34,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","translation":"তোমার দুর্ভোগের উপর দুর্ভোগ।","transliteration":"Awlaa laka fa awlaa"},{"number":5586,"numberInSurah":35,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","translation":"অতঃপর, তোমার দুর্ভোগের উপর দূর্ভোগ।","transliteration":"Summa awlaa laka fa awla"},{"number":5587,"numberInSurah":36,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","translation":"মানুষ কি মনে করে যে, তাকে এমনি ছেড়ে দেয়া হবে?","transliteration":"Ayahsabul insaanu anyytraka sudaa"},{"number":5588,"numberInSurah":37,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ","translation":"সে কি স্খলিত বীর্য ছিল না?","transliteration":"Alam yaku nutfatam mim maniyyiny yumnaa"},{"number":5589,"numberInSurah":38,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ","translation":"অতঃপর সে ছিল রক্তপিন্ড, অতঃপর আল্লাহ তাকে সৃষ্টি করেছেন এবং সুবিন্যস্ত করেছেন।","transliteration":"Summa kaana 'alaqata fakhalaq fasawwaa"},{"number":5590,"numberInSurah":39,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","translation":"অতঃপর তা থেকে সৃষ্টি করেছেন যুগল নর ও নারী।","transliteration":"Faja'ala minhuz zawjayniz zakara wal unsaa"},{"number":5591,"numberInSurah":40,"juz":29,"page":578,"hizbQuarter":231,"sajda":false,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","translation":"তবুও কি সেই আল্লাহ মৃতদেরকে জীবিত করতে সক্ষম নন?","transliteration":"Alaisa zaalika biqaadirin 'alaaa any yuhyiyal mawtaa"}]}