{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","banglaName":"আত-ত্বারিক্ব","banglaTranslation":"রাত্রির আগমনকারী","revelationType":"Meccan","ayahs":[{"number":5932,"numberInSurah":1,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":"শপথ আকাশের এবং রাত্রিতে আগমনকারীর।","transliteration":"Wassamaaa'i wattaariq"},{"number":5933,"numberInSurah":2,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","translation":"আপনি জানেন, যে রাত্রিতে আসে সেটা কি?","transliteration":"Wa maaa adraaka mattaariq"},{"number":5934,"numberInSurah":3,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","translation":"সেটা এক উজ্জ্বল নক্ষত্র।","transliteration":"Annajmus saaqib"},{"number":5935,"numberInSurah":4,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"إِ�� كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","translation":"প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।","transliteration":"In kullu nafsil lammaa 'alaihaa haafiz"},{"number":5936,"numberInSurah":5,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","translation":"অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।","transliteration":"Fal yanzuril insaanu mimma khuliq"},{"number":5937,"numberInSurah":6,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","translation":"সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।","transliteration":"Khuliqa mim maaa'in daafiq"},{"number":5938,"numberInSurah":7,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","translation":"এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।","transliteration":"Yakhruju mim bainissulbi wat taraaa'ib"},{"number":5939,"numberInSurah":8,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","translation":"নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।","transliteration":"Innahoo 'alaa raj'ihee laqaadir"},{"number":5940,"numberInSurah":9,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","translation":"যেদিন গোপন বিষয়াদি পরীক্ষিত হবে,","transliteration":"Yawma tublas saraaa'ir"},{"number":5941,"numberInSurah":10,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","translation":"সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।","transliteration":"Famaa lahoo min quwwatinw wa laa naasir"},{"number":5942,"numberInSurah":11,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","translation":"শপথ চক্রশীল আকাশের","transliteration":"Wassamaaa'i zaatir raj'"},{"number":5943,"numberInSurah":12,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","translation":"এবং বিদারনশীল পৃথিবীর","transliteration":"Wal ardi zaatis sad'"},{"number":5944,"numberInSurah":13,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","translation":"নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।","transliteration":"Innahoo laqawlun fasl"},{"number":5945,"numberInSurah":14,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"وَمَا هُوَ بِٱلْهَزْلِ","translation":"এবং এটা উপহাস নয়।","transliteration":"Wa maa huwa bil hazl"},{"number":5946,"numberInSurah":15,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","translation":"তারা ভীষণ চক্রান্ত করে,","transliteration":"Innahum yakeedoona kaidaa"},{"number":5947,"numberInSurah":16,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"وَأَكِيدُ كَيْدًۭا","translation":"আর আমিও কৌশল করি।","transliteration":"Wa akeedu kaidaa"},{"number":5948,"numberInSurah":17,"juz":30,"page":591,"hizbQuarter":236,"sajda":false,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","translation":"অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।","transliteration":"Famahhilil kaafireena amhilhum ruwaidaa"}]}