{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","banglaName":"আল-'আলাক্ব","banglaTranslation":"রক্তপিণ্ড / ভ্রূণ","revelationType":"Meccan","ayahs":[{"number":6107,"numberInSurah":1,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":"পাঠ করুন আপনার পালনকর্তার নামে যিনি সৃষ্টি করেছেন","transliteration":"Iqra bismi rab bikal lazee khalaq"},{"number":6108,"numberInSurah":2,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","translation":"সৃষ্টি করেছেন মানুষকে জমাট রক্ত থেকে।","transliteration":"Khalaqal insaana min 'alaq"},{"number":6109,"numberInSurah":3,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":"পাঠ করুন, আপনার পালনকর্তা মহা দয়ালু,","transliteration":"Iqra wa rab bukal akram"},{"number":6110,"numberInSurah":4,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":"যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন,","transliteration":"Al lazee 'allama bil qalam"},{"number":6111,"numberInSurah":5,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","translation":"শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।","transliteration":"'Al lamal insaana ma lam y'alam"},{"number":6112,"numberInSurah":6,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","translation":"সত্যি সত্যি মানুষ সীমালংঘন করে,","transliteration":"Kallaa innal insaana layatghaa"},{"number":6113,"numberInSurah":7,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":"এ কারণে যে, সে নিজেকে অভাবমুক্ত মনে করে।","transliteration":"Ar-ra aahus taghnaa"},{"number":6114,"numberInSurah":8,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":"নিশ্চয় আপনার পালনকর্তার দিকেই প্রত্যাবর্তন হবে।","transliteration":"Innna ilaa rabbikar ruj'aa"},{"number":6115,"numberInSurah":9,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":"আপনি কি তাকে দেখেছেন, যে নিষেধ করে","transliteration":"Ara-aital lazee yanhaa"},{"number":6116,"numberInSurah":10,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"عَبْدًا إِذَا صَلَّىٰٓ","translation":"এক বান্দাকে যখন সে নামায পড়ে?","transliteration":"'Abdan iza sallaa"},{"number":6117,"numberInSurah":11,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":"আপনি কি দেখেছেন যদি সে সৎপথে থাকে।","transliteration":"Ara-aita in kana 'alal hudaa"},{"number":6118,"numberInSurah":12,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":"অথবা খোদাভীতি শিক্ষা দেয়।","transliteration":"Au amara bit taqwaa"},{"number":6119,"numberInSurah":13,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"আপনি কি দেখেছেন, যদি সে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।","transliteration":"Ara-aita in kaz zaba wa ta walla"},{"number":6120,"numberInSurah":14,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"সে কি জানে না যে, আল্লাহ দেখেন?","transliteration":"Alam y'alam bi-an nal lahaa yaraa"},{"number":6121,"numberInSurah":15,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":"কখনই নয়, যদি সে বিরত না হয়, তবে আমি মস্তকের সামনের কেশগুচ্ছ ধরে হেঁচড়াবই-","transliteration":"Kalla la illam yantahi la nasfa'am bin nasiyah"},{"number":6122,"numberInSurah":16,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","translation":"মিথ্যাচারী, পাপীর কেশগুচ্ছ।","transliteration":"Nasiyatin kazi batin khaatiyah"},{"number":6123,"numberInSurah":17,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"فَلْيَدْعُ نَادِيَهُۥ","translation":"অতএব, সে তার সভাসদদেরকে আহবান করুক।","transliteration":"Fal yad'u naadiyah"},{"number":6124,"numberInSurah":18,"juz":30,"page":597,"hizbQuarter":239,"sajda":false,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":"আমিও আহবান করব জাহান্নামের প্রহরীদেরকে","transliteration":"Sanad 'uz zabaaniyah"},{"number":6125,"numberInSurah":19,"juz":30,"page":597,"hizbQuarter":239,"sajda":true,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":"কখনই নয়, আপনি তার আনুগত্য করবেন না। আপনি সেজদা করুন ও আমার নৈকট্য অর্জন করুন।","transliteration":"Kalla; la tuti'hu wasjud waqtarib"}]}