{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","banglaName":"আল-কাওসার","banglaTranslation":"প্রচুর কল্যাণ / ঝর্ণা","revelationType":"Meccan","ayahs":[{"number":6205,"numberInSurah":1,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","translation":"নিশ্চয় আমি আপনাকে কাওসার দান করেছি।","transliteration":"Innaa a'taina kal kauthar"},{"number":6206,"numberInSurah":2,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","translation":"অতএব আপনার পালনকর্তার উদ্দেশ্যে নামায পড়ুন এবং কোরবানী করুন।","transliteration":"Fa salli li rabbika wanhar"},{"number":6207,"numberInSurah":3,"juz":30,"page":602,"hizbQuarter":240,"sajda":false,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","translation":"যে আপনার শত্রু, সেই তো লেজকাটা, নির্বংশ।","transliteration":"Inna shani-aka huwal abtar"}]}