{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","banglaName":"আন-নাযি'আত","banglaTranslation":"উৎপাটনকারী","revelationType":"Meccan","ayahs":[{"number":5713,"numberInSurah":1,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا","translation":"শপথ সেই ফেরেশতাগণের, যারা ডুব দিয়ে আত্মা উৎপাটন করে,","transliteration":"Wan naazi 'aati gharqa"},{"number":5714,"numberInSurah":2,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"وَٱلنَّٰشِطَٰتِ نَشْطًۭا","translation":"শপথ তাদের, যারা আত্মার বাঁধন খুলে দেয় মৃদুভাবে;","transliteration":"Wan naa shi taati nashta"},{"number":5715,"numberInSurah":3,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"وَٱلسَّٰبِحَٰتِ سَبْحًۭا","translation":"শপথ তাদের, যারা সন্তরণ করে দ্রুতগতিতে,","transliteration":"Wass saabi-haati sabha"},{"number":5716,"numberInSurah":4,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"فَٱلسَّٰبِقَٰتِ سَبْقًۭا","translation":"শপথ তাদের, যারা দ্রুতগতিতে অগ্রসর হয় এবং","transliteration":"Fass saabi qaati sabqa"},{"number":5717,"numberInSurah":5,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًۭا","translation":"শপথ তাদের, যারা সকল কর্মনির্বাহ করে, কেয়ামত অবশ্যই হবে।","transliteration":"Fal mu dab-bi raati amra"},{"number":5718,"numberInSurah":6,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","translation":"যেদিন প্রকম্পিত করবে প্রকম্পিতকারী,","transliteration":"Yawma tarjufur raajifa"},{"number":5719,"numberInSurah":7,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ","translation":"অতঃপর পশ্চাতে আসবে পশ্চাদগামী;","transliteration":"Tatba'u har raadifa"},{"number":5720,"numberInSurah":8,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ","translation":"সেদিন অনেক হৃদয় ভীত-বিহবল হবে।","transliteration":"Quloobuny-yau maaiziw-waaji-fa"},{"number":5721,"numberInSurah":9,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"أَبْصَٰرُهَا خَٰشِعَةٌۭ","translation":"তাদের দৃষ্টি নত হবে।","transliteration":"Absaa ruhaa khashi'ah"},{"number":5722,"numberInSurah":10,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","translation":"তারা বলেঃ আমরা কি উলটো পায়ে প্রত্যাবর্তিত হবই-","transliteration":"Ya qoo loona a-inna lamar doo doona fil haafirah"},{"number":5723,"numberInSurah":11,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ","translation":"গলিত অস্থি হয়ে যাওয়ার পরও?","transliteration":"Aizaa kunna 'izaa man-nakhirah"},{"number":5724,"numberInSurah":12,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ","translation":"তবে তো এ প্রত্যাবর্তন সর্বনাশা হবে!","transliteration":"Qaalu tilka izan karratun khaasirah."},{"number":5725,"numberInSurah":13,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ","translation":"অতএব, এটা তো কেবল এক মহা-নাদ,","transliteration":"Fa inna ma hiya zajratuw-waahida"},{"number":5726,"numberInSurah":14,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","translation":"তখনই তারা ময়দানে আবির্ভূত হবে।","transliteration":"Faizaa hum biss saahirah"},{"number":5727,"numberInSurah":15,"juz":30,"page":583,"hizbQuarter":233,"sajda":false,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","translation":"মূসার বৃত্তান্ত আপনার কাছে পৌছেছে কি?","transliteration":"Hal ataaka hadeethu Musaa"},{"number":5728,"numberInSurah":16,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","translation":"যখন তার পালনকর্তা তাকে পবিত্র তুয়া উপ্যকায় আহবান করেছিলেন,","transliteration":"Iz nadaahu rabbuhu bil waadil-muqad dasi tuwa"},{"number":5729,"numberInSurah":17,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","translation":"ফেরাউনের কাছে যাও, নিশ্চয় সে সীমালংঘন করেছে।","transliteration":"Izhab ilaa fir'auna innahu taghaa."},{"number":5730,"numberInSurah":18,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","translation":"অতঃপর বলঃ তোমার পবিত্র হওয়ার আগ্রহ আছে কি?","transliteration":"Faqul hal laka ilaa-an tazakka."},{"number":5731,"numberInSurah":19,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","translation":"আমি তোমাকে তোমার পালনকর্তার দিকে পথ দেখাব, যাতে তুমি তাকে ভয় কর।","transliteration":"Wa ahdi yaka ila rabbika fatakh sha"},{"number":5732,"numberInSurah":20,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","translation":"অতঃপর সে তাকে মহা-নিদর্শন দেখাল।","transliteration":"Fa araahul-aayatal kubra."},{"number":5733,"numberInSurah":21,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَكَذَّبَ وَعَصَىٰ","translation":"কিন্তু সে মিথ্যারোপ করল এবং অমান্য করল।","transliteration":"Fa kazzaba wa asaa."},{"number":5734,"numberInSurah":22,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","translation":"অতঃপর সে প্রতিকার চেষ্টায় প্রস্থান করল।","transliteration":"Thumma adbara yas'aa."},{"number":5735,"numberInSurah":23,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَحَشَرَ فَنَادَىٰ","translation":"সে সকলকে সমবেত করল এবং সজোরে আহবান করল,","transliteration":"Fa hashara fanada."},{"number":5736,"numberInSurah":24,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","translation":"এবং বললঃ আমিই তোমাদের সেরা পালনকর্তা।","transliteration":"Faqala ana rabbu kumul-a'laa."},{"number":5737,"numberInSurah":25,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","translation":"অতঃপর আল্লাহ তাকে পরকালের ও ইহকালের শাস্তি দিলেন।","transliteration":"Fa-akha zahul laahu nakalal aakhirati wal-oola."},{"number":5738,"numberInSurah":26,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ","translation":"যে ভয় করে তার জন্যে অবশ্যই এতে শিক্ষা রয়েছে।","transliteration":"Inna fee zaalika la'ibratal limaiy-yaksha"},{"number":5739,"numberInSurah":27,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","translation":"তোমাদের সৃষ্টি অধিক কঠিন না আকাশের, যা তিনি নির্মাণ করেছেন?","transliteration":"A-antum a shaddu khalqan amis samaa-u banaaha."},{"number":5740,"numberInSurah":28,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","translation":"তিনি একে উচ্চ করেছেন ও সুবিন্যস্ত করেছেন।","transliteration":"Raf'a sam kaha fasaw waaha"},{"number":5741,"numberInSurah":29,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","translation":"তিনি এর রাত্রিকে করেছেন অন্ধকারাচ্ছন্ন এবং এর সূর্যোলোক প্রকাশ করেছেন।","transliteration":"Wa aghtasha lailaha wa akhraja duhaaha."},{"number":5742,"numberInSurah":30,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","translation":"পৃথিবীকে এর পরে বিস্তৃত করেছেন।","transliteration":"Wal arda b'ada zaalika dahaaha."},{"number":5743,"numberInSurah":31,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","translation":"তিনি এর মধ্য থেকে এর পানি ও ঘাম নির্গত করেছেন,","transliteration":"Akhraja minha maa-aha wa mar 'aaha."},{"number":5744,"numberInSurah":32,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","translation":"পর্বতকে তিনি দৃঢ়ভাবে প্রতিষ্ঠিত করেছেন,","transliteration":"Wal jibala arsaaha."},{"number":5745,"numberInSurah":33,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":"তোমাদের ও তোমাদের চতুস্পদ জন্তুদের উপকারার্থে।","transliteration":"Mataa'al lakum wali an 'aamikum."},{"number":5746,"numberInSurah":34,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","translation":"অতঃপর যখন মহাসংকট এসে যাবে।","transliteration":"Fa-izaa jaaa'atit taaam matul kubraa."},{"number":5747,"numberInSurah":35,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","translation":"অর্থাৎ যেদিন মানুষ তার কৃতকর্ম স্মরণ করবে","transliteration":"Yauma Yata zakkarul insaanu ma sa'aa."},{"number":5748,"numberInSurah":36,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","translation":"এবং দর্শকদের জন্যে জাহান্নাম প্রকাশ করা হবে,","transliteration":"Wa burrizatil-jaheemu limany-yaraa."},{"number":5749,"numberInSurah":37,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَأَمَّا مَن طَغَىٰ","translation":"তখন যে ব্যক্তি সীমালংঘন করেছে;","transliteration":"Fa ammaa man taghaa."},{"number":5750,"numberInSurah":38,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"এবং পার্থিব জীবনকে অগ্রাধিকার দিয়েছে,","transliteration":"Wa aasaral hayaatad dunyaa"},{"number":5751,"numberInSurah":39,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","translation":"তার ঠিকানা হবে জাহান্নাম।","transliteration":"Fa innal jaheema hiyal maawaa."},{"number":5752,"numberInSurah":40,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"وَ��َمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","translation":"পক্ষান্তরে যে ব্যক্তি তার পালনকর্তার সামনে দন্ডায়মান হওয়াকে ভয় করেছে এবং খেয়াল-খুশী থেকে নিজেকে নিবৃত্ত রেখেছে,","transliteration":"Wa ammaa man khaafa maqaama Rabbihee wa nahan nafsa 'anil hawaa"},{"number":5753,"numberInSurah":41,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","translation":"তার ঠিকানা হবে জান্নাত।","transliteration":"Fa innal jannata hiyal maawaa"},{"number":5754,"numberInSurah":42,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","translation":"তারা আপনাকে জিজ্ঞাসা করে, কেয়ামত কখন হবে?","transliteration":"Yas'aloonaka 'anis saa'ati ayyaana mursaahaa"},{"number":5755,"numberInSurah":43,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","translation":"এর বর্ণনার সাথে আপনার কি সম্পর্ক ?","transliteration":"Feema anta min zikraahaa"},{"number":5756,"numberInSurah":44,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","translation":"এর চরম জ্ঞান আপনার পালনকর্তার কাছে।","transliteration":"Ilaa Rabbika muntahaa haa"},{"number":5757,"numberInSurah":45,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","translation":"যে একে ভয় করে, আপনি তো কেবল তাকেই সতর্ক করবেন।","transliteration":"Innamaaa anta munziru maiy yakshaahaa"},{"number":5758,"numberInSurah":46,"juz":30,"page":584,"hizbQuarter":233,"sajda":false,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","translation":"যেদিন তারা একে দেখবে, সেদিন মনে হবে যেন তারা দুনিয়াতে মাত্র এক সন্ধ্যা অথবা এক সকাল অবস্থান করেছে।","transliteration":"Ka annahum Yawma yarawnahaa lam yalbasooo illaa 'ashiyyatan aw duhaahaa"}]}