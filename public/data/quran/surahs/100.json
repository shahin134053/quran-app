{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","banglaName":"আল-'আদিয়াত","banglaTranslation":"অভিযানকারী অশ্ব","revelationType":"Meccan","ayahs":[{"number":6147,"numberInSurah":1,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","translation":"শপথ উর্ধ্বশ্বাসে চলমান অশ্বসমূহের,","transliteration":"Wal'aadi yaati dabha"},{"number":6148,"numberInSurah":2,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"فَٱلْمُورِيَٰتِ قَدْحًۭا","translation":"অতঃপর ক্ষুরাঘাতে অগ্নিবিচ্ছুরক অশ্বসমূহের","transliteration":"Fal moori yaati qadha"},{"number":6149,"numberInSurah":3,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","translation":"অতঃপর প্রভাতকালে আক্রমণকারী অশ্বসমূহের","transliteration":"Fal mugheeraati subha"},{"number":6150,"numberInSurah":4,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","translation":"ও যারা সে সময়ে ধুলি উৎক্ষিপ্ত করে","transliteration":"Fa atharna bihee naq'a"},{"number":6151,"numberInSurah":5,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","translation":"অতঃপর যারা শক্রদলের অভ্যন্তরে ঢুকে পড়ে-","transliteration":"Fawa satna bihee jam'a"},{"number":6152,"numberInSurah":6,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","translation":"নিশ্চয় মানুষ তার পালনকর্তার প্রতি অকৃতজ্ঞ।","transliteration":"Innal-insana lirabbihee lakanood"},{"number":6153,"numberInSurah":7,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","translation":"এবং সে অবশ্য এ বিষয়ে অবহিত","transliteration":"Wa innahu 'alaa zaalika la shaheed"},{"number":6154,"numberInSurah":8,"juz":30,"page":599,"hizbQuarter":239,"sajda":false,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","translation":"এবং সে নিশ্চিতই ধন-সম্পদের ভালবাসায় মত্ত।","transliteration":"Wa innahu lihubbil khairi la shadeed"},{"number":6155,"numberInSurah":9,"juz":30,"page":599,"hizbQuarter":240,"sajda":false,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","translation":"সে কি জানে না, যখন কবরে যা আছে, তা উত্থিত হবে","transliteration":"Afala ya'lamu iza b'uthira ma filquboor"},{"number":6156,"numberInSurah":10,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","translation":"এবং অন্তরে যা আছে, তা অর্জন করা হবে?","transliteration":"Wa hussila maa fis sudoor"},{"number":6157,"numberInSurah":11,"juz":30,"page":600,"hizbQuarter":240,"sajda":false,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","translation":"সেদিন তাদের কি হবে, সে সম্পর্কে তাদের পালনকর্তা সবিশেষ জ্ঞাত।","transliteration":"Inna rabbahum bihim yauma 'izil la khabeer"}]}