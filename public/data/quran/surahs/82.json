{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","banglaName":"আল-ইনফিতার","banglaTranslation":"বিদীর্ণ হওয়া","revelationType":"Meccan","ayahs":[{"number":5830,"numberInSurah":1,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","translation":"যখন আকাশ বিদীর্ণ হবে,","transliteration":"Izas samaaa'un fatarat"},{"number":5831,"numberInSurah":2,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","translation":"যখন নক্ষত্রসমূহ ঝরে পড়বে,","transliteration":"Wa izal kawaakibun tasarat"},{"number":5832,"numberInSurah":3,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","translation":"যখন সমুদ্রকে উত্তাল করে তোলা হবে,","transliteration":"Wa izal bihaaru fujjirat"},{"number":5833,"numberInSurah":4,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","translation":"এবং যখন কবরসমূহ উম্মোচিত হবে,","transliteration":"Wa izal qubooru bu'sirat"},{"number":5834,"numberInSurah":5,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","translation":"তখন প্রত্যেকে জেনে নিবে সে কি অগ্রে প্রেরণ করেছে এবং কি পশ্চাতে ছেড়ে এসেছে।","transliteration":"'Alimat nafsum maa qaddamat wa akhkharat"},{"number":5835,"numberInSurah":6,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","translation":"হে মানুষ, কিসে তোমাকে তোমার মহামহিম পালনকর্তা সম্পর্কে বিভ্রান্ত করল?","transliteration":"Yaaa ayyuhal insaaanu maa gharraka bi Rabbikal kareem"},{"number":5836,"numberInSurah":7,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","translation":"যিনি তোমাকে সৃষ্টি করেছেন, অতঃপর তোমাকে সুবিন্যস্ত করেছেন এবং সুষম করেছেন।","transliteration":"Allazee khalaqaka fasaw waaka fa'adalak"},{"number":5837,"numberInSurah":8,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","translation":"যিনি তোমাকে তাঁর ইচ্ছামত আকৃতিতে গঠন করেছেন।","transliteration":"Feee ayye sooratim maa shaaa'a rakkabak"},{"number":5838,"numberInSurah":9,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","translation":"কখনও বিভ্রান্ত হয়ো না; বরং তোমরা দান-প্রতিদানকে মিথ্যা মনে কর।","transliteration":"Kalla bal tukazziboona bid deen"},{"number":5839,"numberInSurah":10,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","translation":"অবশ্যই তোমাদের উপর তত্ত্বাবধায়ক নিযুক্ত আছে।","transliteration":"Wa inna 'alaikum lahaa fizeen"},{"number":5840,"numberInSurah":11,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"كِرَامًۭا كَٰتِبِينَ","translation":"সম্মানিত আমল লেখকবৃন্দ।","transliteration":"Kiraaman kaatibeen"},{"number":5841,"numberInSurah":12,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","translation":"তারা জানে যা তোমরা কর।","transliteration":"Ya'lamoona ma taf'aloon"},{"number":5842,"numberInSurah":13,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","translation":"সৎকর্মশীলগণ থাকবে জান্নাতে।","transliteration":"Innal abraara lafee na'eem"},{"number":5843,"numberInSurah":14,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","translation":"এবং দুষ্কর্মীরা থাকবে জাহান্নামে;","transliteration":"Wa innal fujjaara lafee jaheem"},{"number":5844,"numberInSurah":15,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","translation":"তারা বিচার দিবসে তথায় প্রবেশ করবে।","transliteration":"Yaslawnahaa Yawmad Deen"},{"number":5845,"numberInSurah":16,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","translation":"তারা সেখান থেকে পৃথক হবে না।","transliteration":"Wa maa hum 'anhaa bighaaa 'ibeen"},{"number":5846,"numberInSurah":17,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":"আপনি জানেন, বিচার দিবস কি?","transliteration":"Wa maaa adraaka maa Yawmud Deen"},{"number":5847,"numberInSurah":18,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":"অতঃপর আপনি জানেন, বিচার দিবস কি?","transliteration":"Summa maaa adraaka maa Yawmud Deen"},{"number":5848,"numberInSurah":19,"juz":30,"page":587,"hizbQuarter":235,"sajda":false,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","translation":"যেদিন কেউ কারও কোন উপকার করতে পারবে না এবং সেদিন সব কতৃꦣ2468;্ব হবে আল্লাহর।","transliteration":"Yawma laa tamliku nafsul linafsin shai'anw walamru yawma'izil lillaah"}]}