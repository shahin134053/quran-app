{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","banglaName":"আল-হুমাযাহ","banglaTranslation":"পরনিন্দাকারী","revelationType":"Meccan","ayahs":[{"number":6180,"numberInSurah":1,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","translation":"প্রত্যেক পশ্চাতে ও সম্মুখে পরনিন্দাকারীর দুর্ভোগ,","transliteration":"Wai lul-li kulli hu mazatil-lumaza"},{"number":6181,"numberInSurah":2,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","translation":"যে অর্থ সঞ্চিত করে ও গণনা করে","transliteration":"Al-lazi jama'a maalaw wa'addadah"},{"number":6182,"numberInSurah":3,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translation":"সে মনে করে যে, তার অর্থ চিরকাল তার সাথে থাকবে!","transliteration":"Yahsabu anna maalahu akhladah"},{"number":6183,"numberInSurah":4,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translation":"কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে পিষ্টকারীর মধ্যে।","transliteration":"Kalla layum ba zanna fil hutamah"},{"number":6184,"numberInSurah":5,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translation":"আপনি কি জানেন, পিষ্টকারী কি?","transliteration":"Wa maa adraaka mal-hutamah"},{"number":6185,"numberInSurah":6,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translation":"এটা আল্লাহর প্রজ্জ্বলিত অগ্নি,","transliteration":"Narul laahil-mooqada"},{"number":6186,"numberInSurah":7,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","translation":"যা হৃদয় পর্যন্ত পৌছবে।","transliteration":"Al latee tat tali'u 'alalafidah"},{"number":6187,"numberInSurah":8,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","translation":"এতে তাদেরকে বেঁধে দেয়া হবে,","transliteration":"Innaha 'alaihim moosada"},{"number":6188,"numberInSurah":9,"juz":30,"page":601,"hizbQuarter":240,"sajda":false,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","translation":"লম্বা লম্বা খুঁটিতে।","transliteration":"Fee 'amadim-mu mad dadah"}]}