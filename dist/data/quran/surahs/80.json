{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","banglaName":"'আবাসা","banglaTranslation":"ভ্রূকুঞ্চিত","revelationType":"Meccan","ayahs":[{"number":5759,"numberInSurah":1,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","translation":"তিনি ভ্রূকুঞ্চিত করলেন এবং মুখ ফিরিয়ে নিলেন।","transliteration":"'Abasa wa tawallaa."},{"number":5760,"numberInSurah":2,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","translation":"কারণ, তাঁর কাছে এক অন্ধ আগমন করল।","transliteration":"An jaa-ahul 'a-maa"},{"number":5761,"numberInSurah":3,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"আপনি কি জানেন, সে হয়তো পরিশুদ্ধ হত,","transliteration":"Wa maa yudreeka la'allahu yaz zakkaa."},{"number":5762,"numberInSurah":4,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","translation":"অথবা উপদেশ গ্রহণ করতো এবং উপদেশ তার উপকার হত।","transliteration":"Au yaz zak karu fatanfa 'ahuz zikraa."},{"number":5763,"numberInSurah":5,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","translation":"পরন্তু যে বেপরোয়া,","transliteration":"Amma manis taghnaa"},{"number":5764,"numberInSurah":6,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"আপনি তার চিন্তায় মশগুল।","transliteration":"Fa-anta lahu tasaddaa"},{"number":5765,"numberInSurah":7,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","translation":"সে শুদ্ধ না হলে আপনার কোন দোষ নেই।","transliteration":"Wa ma 'alaika allaa yaz zakka."},{"number":5766,"numberInSurah":8,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","translation":"যে আপনার কাছে দৌড়ে আসলো","transliteration":"Wa amma man jaa-aka yas'a"},{"number":5767,"numberInSurah":9,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَهُوَ يَخْشَىٰ","translation":"এমতাবস্থায় যে, সে ভয় করে,","transliteration":"Wahuwa yakhshaa,"},{"number":5768,"numberInSurah":10,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","translation":"আপনি তাকে অবজ্ঞা করলেন।","transliteration":"Fa-anta 'anhu talah haa."},{"number":5769,"numberInSurah":11,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","translation":"কখনও এরূপ করবেন না, এটা উপদেশবানী।","transliteration":"Kalla innaha tazkirah"},{"number":5770,"numberInSurah":12,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"অতএব, যে ইচ্ছা করবে, সে একে গ্রহণ করবে।","transliteration":"Faman shaa a zakarah"},{"number":5771,"numberInSurah":13,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","translation":"এটা লিখিত আছে সম্মানিত,","transliteration":"Fi suhufim mukar rama,"},{"number":5772,"numberInSurah":14,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","translation":"উচ্চ পবিত্র পত্রসমূহে,","transliteration":"Marfoo'atim mutah hara,"},{"number":5773,"numberInSurah":15,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"بِأَيْدِى سَفَرَةٍۢ","translation":"লিপিকারের হস্তে,","transliteration":"Bi'aidee safara"},{"number":5774,"numberInSurah":16,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"كِرَامٍۭ بَرَرَةٍۢ","translation":"যারা মহৎ, পূত চরিত্র।","transliteration":"Kiraamim bararah."},{"number":5775,"numberInSurah":17,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","translation":"মানুষ ধ্বংস হোক, সে কত অকৃতজ্ঞ!","transliteration":"Qutilal-insanu maa akfarah."},{"number":5776,"numberInSurah":18,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","translation":"তিনি তাকে কি বস্তু থেকে সৃষ্টি করেছেন?","transliteration":"Min aiyyi shai-in Khalaq"},{"number":5777,"numberInSurah":19,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":"শুক্র থেকে তাকে সৃষ্টি করেছেন, অতঃপর তাকে সুপরিমিত করেছেন।","transliteration":"Min nutfah; khalaqahu faqad-darah."},{"number":5778,"numberInSurah":20,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":"অতঃপর তার পথ সহজ করেছেন,","transliteration":"Thummas sabeela yas-sarah"},{"number":5779,"numberInSurah":21,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","translation":"অতঃপর তার মৃত্যু ঘটান ও কবরস্থ করেন তাকে।","transliteration":"Thumma amatahu fa-aqbarah"},{"number":5780,"numberInSurah":22,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":"এরপর যখন ইচ্ছা করবেন তখন তাকে পুনরুজ্জীবিত করবেন।","transliteration":"Thumma iza shaa-a ansharah"},{"number":5781,"numberInSurah":23,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","translation":"সে কখনও কৃতজ্ঞ হয়নি, তিনি তাকে যা আদেশ করেছেন, সে তা পূর্ণ করেনি।","transliteration":"Kalla lamma yaqdi maa amarah."},{"number":5782,"numberInSurah":24,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":"মানুষ তার খাদ্যের প্রতি লক্ষ্য করুক,","transliteration":"Falyanzuril insanu ilaa ta-amih"},{"number":5783,"numberInSurah":25,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","translation":"আমি আশ্চর্য উপায়ে পানি বর্ষণ করেছি,","transliteration":"Anna sabab nalmaa-a sabba."},{"number":5784,"numberInSurah":26,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","translation":"এরপর আমি ভূমিকে বিদীর্ণ করেছি,","transliteration":"Thumma sha qaqnal-arda shaqqa."},{"number":5785,"numberInSurah":27,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","translation":"অতঃপর তাতে উৎপন্ন করেছি শস্য,","transliteration":"Fa ambatna feeha habba"},{"number":5786,"numberInSurah":28,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَعِنَبًۭا وَقَضْبًۭا","translation":"আঙ্গুর, শাক-সব্জি,","transliteration":"Wa 'inabaw-wa qadba"},{"number":5787,"numberInSurah":29,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَزَيْتُونًۭا وَنَخْلًۭا","translation":"যয়তুন, খর্জূর,","transliteration":"Wa zaitoonaw wanakh la'"},{"number":5788,"numberInSurah":30,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَحَدَآئِقَ غُلْبًۭا","translation":"ঘন উদ্যান,","transliteration":"Wa hadaa-iqa ghulba"},{"number":5789,"numberInSurah":31,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَفَٰكِهَةًۭ وَأَبًّۭا","translation":"ফল এবং ঘাস","transliteration":"Wa faki hataw-wa abba."},{"number":5790,"numberInSurah":32,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":"তোমাদেরও তোমাদের চতুস্পদ জন্তুদের উপাকারার্থে।","transliteration":"Mata'al-lakum wa li-an'amikum."},{"number":5791,"numberInSurah":33,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":"অতঃপর যেদিন কর্ণবিদারক নাদ আসবে,","transliteration":"Faiza jaa-atis saakhah."},{"number":5792,"numberInSurah":34,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","translation":"সেদিন পলায়ন করবে মানুষ তার ভ্রাতার কাছ থেকে,","transliteration":"Yauma yafir-rul mar-u min akheeh"},{"number":5793,"numberInSurah":35,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَأُمِّهِۦ وَأَبِيهِ","translation":"তার মাতা, তার পিতা,","transliteration":"Wa ummihee wa abeeh"},{"number":5794,"numberInSurah":36,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","translation":"তার পত্নী ও তার সন্তানদের কাছ থেকে।","transliteration":"Wa sahi batihee wa baneeh."},{"number":5795,"numberInSurah":37,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","translation":"সেদিন প্রত্যেকেরই নিজের এক চিন্তা থাকবে, যা তাকে ব্যতিব্যস্ত করে রাখবে।","transliteration":"Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh"},{"number":5796,"numberInSurah":38,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","translation":"অনেক মুখমন্ডল সেদিন হবে উজ্জ্বল,","transliteration":"Wujoo huny-yauma-izim-musfira;"},{"number":5797,"numberInSurah":39,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","translation":"সহাস্য ও প্রফুল্ল।","transliteration":"Dahi katum mustab shirah"},{"number":5798,"numberInSurah":40,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","translation":"এবং অনেক মুখমন্ডল সেদিন হবে ধুলি ধূসরিত।","transliteration":"Wa wujoohuy yauma-izin 'alaiha ghabar a"},{"number":5799,"numberInSurah":41,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"تَرْهَقُهَا قَتَرَةٌ","translation":"তাদেরকে কালিমা আচ্ছন্ন করে রাখবে।","transliteration":"Tarhaquha qatarah."},{"number":5800,"numberInSurah":42,"juz":30,"page":585,"hizbQuarter":234,"sajda":false,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","translation":"তারাই কাফের পাপিষ্ঠের দল।","transliteration":"Ulaa-ika humul-kafa ratul-fajarah."}]}