{"number":56,"name":"سُورَةُ الوَاقِعَةِ","englishName":"Al-Waaqia","englishNameTranslation":"The Inevitable","banglaName":"আল-ওয়াক্বি'আহ","banglaTranslation":"সুনিশ্চিত ঘটনা","revelationType":"Meccan","ayahs":[{"number":4980,"numberInSurah":1,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","translation":"যখন কিয়ামতের ঘটনা ঘটবে,","transliteration":"Izaa waqa'atil waaqi'ah"},{"number":4981,"numberInSurah":2,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","translation":"যার বাস্তবতায় কোন সংশয় নেই।","transliteration":"Laisa liwaq'atihaa kaazibah"},{"number":4982,"numberInSurah":3,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"خَافِضَةٌۭ رَّافِعَةٌ","translation":"এটা নীচু করে দেবে, সমুন্নত করে দেবে।","transliteration":"Khafidatur raafi'ah"},{"number":4983,"numberInSurah":4,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا","translation":"যখন প্রবলভাবে প্রকম্পিত হবে পৃথিবী।","transliteration":"Izaa rujjatil ardu rajjaa"},{"number":4984,"numberInSurah":5,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا","translation":"এবং পর্বতমালা ভেঙ্গে চুরমার হয়ে যাবে।","transliteration":"Wa bussatil jibaalu bassaa"},{"number":4985,"numberInSurah":6,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا","translation":"অতঃপর তা হয়ে যাবে উৎক্ষিপ্ত ধূলিকণা।","transliteration":"Fakaanat habaaa'am mumbassaa"},{"number":4986,"numberInSurah":7,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ","translation":"এবং তোমরা তিনভাবে বিভক্ত হয়ে পড়বে।","transliteration":"Wa kuntum azwaajan salaasah"},{"number":4987,"numberInSurah":8,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ","translation":"যারা ডান দিকে, কত ভাগ্যবান তারা।","transliteration":"Fa as haabul maimanati maaa as haabul maimanah"},{"number":4988,"numberInSurah":9,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","translation":"এবং যারা বামদিকে, কত হতভাগা তারা।","transliteration":"Wa as haabul mash'amati maaa as haabul mash'amah"},{"number":4989,"numberInSurah":10,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ","translation":"অগ্রবর্তীগণ তো অগ্রবর্তীই।","transliteration":"Wassaabiqoonas saabiqoon"},{"number":4990,"numberInSurah":11,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ","translation":"তারাই নৈকট্যশীল,","transliteration":"Ulaaa'ikal muqarraboon"},{"number":4991,"numberInSurah":12,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"فِى جَنَّٰتِ ٱلنَّعِيمِ","translation":"অবদানের উদ্যানসমূহে,","transliteration":"Fee Jannaatin Na'eem"},{"number":4992,"numberInSurah":13,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","translation":"তারা একদল পূর্ববর্তীদের মধ্য থেকে।","transliteration":"Sullatum minal awwaleen"},{"number":4993,"numberInSurah":14,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ","translation":"এবং অল্পসংখ্যক পরবর্তীদের মধ্যে থেকে।","transliteration":"Wa qaleelum minal aa khireen"},{"number":4994,"numberInSurah":15,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ","translation":"স্বর্ণ খচিত সিংহাসন।","transliteration":"'Alaa sururim mawdoonah"},{"number":4995,"numberInSurah":16,"juz":27,"page":534,"hizbQuarter":214,"sajda":false,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ","translation":"তারা তাতে হেলান দিয়ে বসবে পরস্পর মুখোমুখি হয়ে।","transliteration":"Muttaki'eena 'alaihaa mutaqabileen"},{"number":4996,"numberInSurah":17,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ","translation":"তাদের কাছে ঘোরাফেরা করবে চির কিশোরেরা।","transliteration":"Yatoofu 'alaihim wildaa num mukkhalladoon"},{"number":4997,"numberInSurah":18,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ","translation":"পানপাত্র কুঁজা ও খাঁটি সূরাপূর্ণ পেয়ালা হাতে নিয়ে,","transliteration":"Bi akwaabinw wa abaareeq, wa kaasim mim ma'een"},{"number":4998,"numberInSurah":19,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","translation":"যা পান করলে তাদের শিরঃপীড়া হবে না এবং বিকারগ্রস্ত ও হবে না।","transliteration":"Laa yusadda'oona 'anhaa wa laa yunzifoon"},{"number":4999,"numberInSurah":20,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ","translation":"আর তাদের পছন্দমত ফল-মুল নিয়ে,","transliteration":"Wa faakihatim mimmaa yatakhaiyaroon"},{"number":5000,"numberInSurah":21,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ","translation":"এবং রুচিমত পাখীর মাংস নিয়ে।","transliteration":"Wa lahmi tairim mimmaa yashtahoon"},{"number":5001,"numberInSurah":22,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَحُورٌ عِينٌۭ","translation":"তথায় থাকবে আনতনয়না হুরগণ,","transliteration":"Wa hoorun'een"},{"number":5002,"numberInSurah":23,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","translation":"আবরণে রক্ষিত মোতির ন্যায়,","transliteration":"Ka amsaalil lu'lu'il maknoon"},{"number":5003,"numberInSurah":24,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","translation":"তারা যা কিছু করত, তার পুরস্কারস্বরূপ।","transliteration":"Jazaaa'am bimaa kaanoo ya'maloon"},{"number":5004,"numberInSurah":25,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا","translation":"তারা তথায় অবান্তর ও কোন খারাপ কথা শুনবে না।","transliteration":"Laa yasma'oona feehaa laghwanw wa laa taaseemaa"},{"number":5005,"numberInSurah":26,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا","translation":"কিন্তু শুনবে সালাম আর সালাম।","transliteration":"Illaa qeelan salaaman salaamaa"},{"number":5006,"numberInSurah":27,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ","translation":"যারা ডান দিকে থাকবে, তারা কত ভাগ্যবান।","transliteration":"Wa as haabul yameeni maaa as haabul Yameen"},{"number":5007,"numberInSurah":28,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"فِى سِدْرٍۢ مَّخْضُودٍۢ","translation":"তারা থাকবে কাঁটাবিহীন বদরিকা বৃক্ষে।","transliteration":"Fee sidrim makhdood"},{"number":5008,"numberInSurah":29,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَطَلْحٍۢ مَّنضُودٍۢ","translation":"এবং কাঁদি কাঁদি কলায়,","transliteration":"Wa talhim mandood"},{"number":5009,"numberInSurah":30,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَظِلٍّۢ مَّمْدُودٍۢ","translation":"এবং দীর্��� ছায়ায়।","transliteration":"Wa zillim mamdood"},{"number":5010,"numberInSurah":31,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَمَآءٍۢ مَّسْكُوبٍۢ","translation":"এবং প্রবাহিত পানিতে,","transliteration":"Wa maaa'im maskoob"},{"number":5011,"numberInSurah":32,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَفَٰكِهَةٍۢ كَثِيرَةٍۢ","translation":"ও প্রচুর ফল-মূলে,","transliteration":"Wa faakihatin kaseerah"},{"number":5012,"numberInSurah":33,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ","translation":"যা শেষ হবার নয় এবং নিষিদ্ধ ও নয়,","transliteration":"Laa maqtoo'atinw wa laa mamnoo'ah"},{"number":5013,"numberInSurah":34,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَفُرُشٍۢ مَّرْفُوعَةٍ","translation":"আর থাকবে সমুন্নত শয্যায়।","transliteration":"Wa furushim marfoo'ah"},{"number":5014,"numberInSurah":35,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ","translation":"আমি জান্নাতী রমণীগণকে বিশেষরূপে সৃষ্টি করেছি।","transliteration":"Innaaa anshaanaahunna inshaaa'aa"},{"number":5015,"numberInSurah":36,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"فَجَعَلْنَٰهُنَّ أَبْكَارًا","translation":"অতঃপর তাদেরকে করেছি চিরকুমারী।","transliteration":"Faja'alnaahunna abkaaraa"},{"number":5016,"numberInSurah":37,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"عُرُبًا أَتْرَابًۭا","translation":"কামিনী, সমবয়স্কা।","transliteration":"'Uruban atraabaa"},{"number":5017,"numberInSurah":38,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"لِّأَصْحَٰبِ ٱلْيَمِينِ","translation":"ডান দিকের লোকদের জন্যে।","transliteration":"Li as haabil yameen"},{"number":5018,"numberInSurah":39,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","translation":"তাদের একদল হবে পূর্ববর্তীদের মধ্য থেকে।","transliteration":"Sullatum minal awwa leen"},{"number":5019,"numberInSurah":40,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ","translation":"এবং একদল পরবর্তীদের মধ্য থেকে।","transliteration":"Wa sullatum minal aakhireen"},{"number":5020,"numberInSurah":41,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ","translation":"বামপার্শ্বস্থ লোক, কত না হতভাগা তারা।","transliteration":"Wa as haabush shimaali maaa as haabush shimaal"},{"number":5021,"numberInSurah":42,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"فِى سَمُومٍۢ وَحَمِيمٍۢ","translation":"তারা থাকবে প্রখর বাষ্পে এবং উত্তপ্ত পানিতে,","transliteration":"Fee samoominw wa hameem"},{"number":5022,"numberInSurah":43,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَظِلٍّۢ مِّن يَحْمُومٍۢ","translation":"এবং ধুম্রকুঞ্জের ছায়ায়।","transliteration":"Wa zillim miny yahmoom"},{"number":5023,"numberInSurah":44,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"لَّا بَارِدٍۢ وَلَا كَرِيمٍ","translation":"যা শীতল নয় এবং আরামদায়কও নয়।","transliteration":"Laa baaridinw wa laa kareem"},{"number":5024,"numberInSurah":45,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","translation":"তারা ইতিপূর্বে স্বাচ্ছন্দ্যশীল ছিল।","transliteration":"Innaahum kaanoo qabla zaalika mutrafeen"},{"number":5025,"numberInSurah":46,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","translation":"তারা সদাসর্বদা ঘোরতর পাপকর্মে ডুবে থাকত।","transliteration":"Wa kaanoo yusirroona 'alal hinsil 'azeem"},{"number":5026,"numberInSurah":47,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","translation":"তারা বলতঃ আমরা যখন মরে অস্থি ও মৃত্তিকায় পরিণত হয়ে যাব, তখনও কি পুনরুত্থিত হব?","transliteration":"Wa kaanoo yaqooloona a'izaa mitnaa wa kunnaa turaabanw wa izaaman'ainnaa lamab'oosoon"},{"number":5027,"numberInSurah":48,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","translation":"এবং আমাদের পূর্বপুরুষগণও!","transliteration":"Awa aabaaa'unal awwaloon"},{"number":5028,"numberInSurah":49,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ","translation":"বলুনঃ পূর্ববর্তী ও পরবর্তীগণ,","transliteration":"Qul innal awwaleena wal aakhireen"},{"number":5029,"numberInSurah":50,"juz":27,"page":535,"hizbQuarter":214,"sajda":false,"text":"لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ","translation":"সবাই একত্রিত হবে এক নির্দিষ্ট দিনের নির্দিষ্ট সময়ে।","transliteration":"Lamajmoo'oona ilaa meeqaati yawmim ma'loon"},{"number":5030,"numberInSurah":51,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","translation":"অতঃপর হে পথভ্রষ্ট, মিথ্যারোপকারীগণ।","transliteration":"summa innakum ayyuhad daaalloonal mukazziboon"},{"number":5031,"numberInSurah":52,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ","translation":"তোমরা অবশ্যই ভক্ষণ করবে যাক্কুম বৃক্ষ থেকে,","transliteration":"La aakiloona min shaja rim min zaqqoom"},{"number":5032,"numberInSurah":53,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","translation":"অতঃপর তা দ্বারা উদর পূর্ণ করবে,","transliteration":"Famaali'oona minhal butoon"},{"number":5033,"numberInSurah":54,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","translation":"অতঃপর তার উপর পান করবে উত্তপ্ত পানি।","transliteration":"Fashaariboona 'alaihi minal hameem"},{"number":5034,"numberInSurah":55,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ","translation":"পান করবে পিপাসিত উটের ন্যায়।","transliteration":"Fashaariboona shurbal heem"},{"number":5035,"numberInSurah":56,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","translation":"কেয়ামতের দিন এটাই হবে তাদের আপ্যায়ন।","transliteration":"Haazaa nuzuluhum yawmad deen"},{"number":5036,"numberInSurah":57,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ","translation":"আমি সৃষ্টি করেছি তোমাদেরকে। অতঃপর কেন তোমরা তা সত্য বলে বিশ্বাস কর না।","transliteration":"Nahnu khalaqnaakum falaw laa tusaddiqoon"},{"number":5037,"numberInSurah":58,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"أَفَرَءَيْتُم مَّا تُمْنُونَ","translation":"তোমরা কি ভেবে দেখেছ, তোমাদের বীর্যপাত সম্পর্কে।","transliteration":"Afara'aytum maa tumnoon"},{"number":5038,"numberInSurah":59,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ","translation":"তোমরা তাকে সৃষ্টি কর, না আমি সৃষ্টি করি?","transliteration":"'A-antum takhluqoo nahooo am nahnul khaaliqoon"},{"number":5039,"numberInSurah":60,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","translation":"আমি তোমাদের মৃত্যুকাল নির্ধারিত করেছি এবং আমি অক্ষম নই।","transliteration":"Nahnu qaddarnaa baina kumul mawta wa maa nahnu bimasbooqeen"},{"number":5040,"numberInSurah":61,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","translation":"এ ব্যাপারে যে, তোমাদের পরিবর্তে তোমাদের মত লোককে নিয়ে আসি এবং তোমাদেরকে এমন করে দেই, যা তোমরা জান না।","transliteration":"'Alaaa an nubaddila amsaalakum wa nunshi'akum fee maa laa ta'lamoon"},{"number":5041,"numberInSurah":62,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","translation":"তোমরা অবগত হয়েছ প্রথম সৃষ্টি সম্পর্কে, তবে তোমরা অনুধাবন কর না কেন?","transliteration":"Wa laqad 'alimtumun nash atal oolaa falaw laa tazakkaroon"},{"number":5042,"numberInSurah":63,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","translation":"তোমরা যে বীজ বপন কর, সে সম্পর্কে ভেবে দেখেছ কি?","transliteration":"Afara'aytum maa tahrusoon"},{"number":5043,"numberInSurah":64,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","translation":"তোমরা তাকে উৎপন্ন কর, না আমি উৎপন্নকারী ?","transliteration":"'A-antum tazra'oonahooo am nahnuz zaari'ooon"},{"number":5044,"numberInSurah":65,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ","translation":"আমি ইচ্ছা করলে তাকে খড়কুটা করে দিতে পারি, অতঃপর হয়ে যাবে তোমরা বিস্ময়াবিষ্ট।","transliteration":"Law nashaaa'u laja'al naahu hutaaman fazaltum tafakkahoon"},{"number":5045,"numberInSurah":66,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"إِنَّا لَمُغْرَمُونَ","translation":"বলবেঃ আমরা তো ঋণের চাপে পড়ে গেলাম;","transliteration":"Innaa lamughramoon"},{"number":5046,"numberInSurah":67,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"بَلْ نَحْنُ مَحْرُومُونَ","translation":"বরং আমরা হূত সর্বস্ব হয়ে পড়লাম।","transliteration":"Bal nahnu mahroomoon"},{"number":5047,"numberInSurah":68,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","translation":"তোমরা যে পানি পান কর, সে সম্পর্কে ভেবে দেখেছ কি?","transliteration":"Afara'aytumul maaa'allazee tashraboon"},{"number":5048,"numberInSurah":69,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","translation":"তোমরা তা মেঘ থেকে নামিয়ে আন, না আমি বর্ষন করি?","transliteration":"'A-antum anzaltumoohu minal muzni am nahnul munziloon"},{"number":5049,"numberInSurah":70,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ","translation":"আমি ইচ্ছা করলে তাকে লোনা করে দিতে পারি, অতঃপর তোমরা কেন কৃতজ্ঞতা প্রকাশ কর না?","transliteration":"Law nashaaa'u ja'alnaahu ujaajan falaw laa tashkuroon"},{"number":5050,"numberInSurah":71,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","translation":"তোমরা যে অগ্নি প্রজ্জ্বলিত কর, সে সম্পর্কে ভেবে দেখেছ কি?","transliteration":"Afara'aytumun naaral latee tooroon"},{"number":5051,"numberInSurah":72,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","translation":"তোমরা কি এর বৃক্ষ সৃষ্টি করেছ, না আমি সৃষ্টি করেছি ?","transliteration":"'A-antum anshaatum shajaratahaaa am nahnul munshi'oon"},{"number":5052,"numberInSurah":73,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ","translation":"আমি সেই বৃক্ষকে করেছি স্মরণিকা এবং মরুবাসীদের জন্য সামগ্রী।","transliteration":"Nahnu ja'alnaahaa tazkira tanw wa mataa'al lilmuqween"},{"number":5053,"numberInSurah":74,"juz":27,"page":536,"hizbQuarter":214,"sajda":false,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","translation":"অতএব, আপনি আপনার মহান পালনকর্তার নামে পবিত্রতা ঘোষণা করুন।","transliteration":"Fasabbih bismi Rabbikal 'azeem"},{"number":5054,"numberInSurah":75,"juz":27,"page":536,"hizbQuarter":215,"sajda":false,"text":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","translation":"অতএব, আমি তারকারাজির অস্তাচলের শপথ করছি,","transliteration":"Falaa uqsimu bimaawaa qi'innujoom"},{"number":5055,"numberInSurah":76,"juz":27,"page":536,"hizbQuarter":215,"sajda":false,"text":"وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ","translation":"নিশ্চয় এটা এক মহা শপথ-যদি তোমরা জানতে।","transliteration":"Wa innahoo laqasamul lawta'lamoona'azeem"},{"number":5056,"numberInSurah":77,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ","translation":"নিশ্চয় এটা সম্মানিত কোরআন,","transliteration":"Innahoo la quraanun kareem"},{"number":5057,"numberInSurah":78,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فِى كِتَٰبٍۢ مَّكْنُونٍۢ","translation":"যা আছে এক গোপন কিতাবে,","transliteration":"Fee kitaabim maknoon"},{"number":5058,"numberInSurah":79,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","translation":"যারা পাক-পবিত্র, তারা ব্যতীত অন্য কেউ একে স্পর্শ করবে না।","transliteration":"Laa yamassuhooo illal mutahharoon"},{"number":5059,"numberInSurah":80,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","translation":"এটা বিশ্ব-পালনকর্তার পক্ষ থেকে অবতীর্ণ।","transliteration":"Tanzeelum mir Rabbil'aalameen"},{"number":5060,"numberInSurah":81,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","translation":"তবুও কি তোমরা এই বাণীর প্রতি শৈথিল্য পদর্শন করবে?","transliteration":"Afabihaazal hadeesi antum mudhinoon"},{"number":5061,"numberInSurah":82,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","translation":"এবং একে মিথ্যা বলাকেই তোমরা তোমাদের ভূমিকায় পরিণত করবে?","transliteration":"Wa taj'aloona rizqakum annakum tukazziboon"},{"number":5062,"numberInSurah":83,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","translation":"অতঃপর যখন কারও প্রাণ কন্ঠাগত হয়।","transliteration":"Falaw laaa izaa balaghatil hulqoom"},{"number":5063,"numberInSurah":84,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ","translation":"এবং তোমরা তাকিয়ে থাক,","transliteration":"Wa antum heena'izin tanzuroon"},{"number":5064,"numberInSurah":85,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ","translation":"তখন আমি তোমাদের অপেক্ষা তার অধিক নিকটে থাকি; কিন্তু তোমরা দেখ না।","transliteration":"Wa nahnu aqrabu ilaihi minkum wa laakil laa tubsiroon"},{"number":5065,"numberInSurah":86,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","translation":"যদি তোমাদের হিসাব-কিতাব না হওয়াই ঠিক হয়,","transliteration":"Falaw laaa in kuntum ghira madeeneen"},{"number":5066,"numberInSurah":87,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ","translation":"তবে তোমরা এই আত্মাকে ফিরাও না কেন, যদি তোমরা সত্যবাদী হও ?","transliteration":"Tarji'oonahaaa in kuntum saadiqeen"},{"number":5067,"numberInSurah":88,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","translation":"যদি সে নৈকট্যশীলদের একজন হয়;","transliteration":"Fa ammaaa in kaana minal muqarrabeen"},{"number":5068,"numberInSurah":89,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ","translation":"তবে তার জন্যে আছে সুখ, উত্তম রিযিক এবং নেয়ামতে ভরা উদ্যান।","transliteration":"Farawhunw wa raihaa nunw wa jannatu na'eem"},{"number":5069,"numberInSurah":90,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","translation":"আর যদি সে ডান পার্শ্বস্থদের একজন হয়,","transliteration":"Wa ammaaa in kaana min as haabil yameen"},{"number":5070,"numberInSurah":91,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","translation":"তবে তাকে বলা হবেঃ তোমার জন্যে ডানপার্শ্বসস্থদের পক্ষ থেকে সালাম।","transliteration":"Fasalaamul laka min as haabil yameen"},{"number":5071,"numberInSurah":92,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","translation":"আর যদি সে পথভ্রষ্ট মিথ্যারোপকারীদের একজন হয়,","transliteration":"Wa ammaaa in kaana minal mukazzibeenad daaalleen"},{"number":5072,"numberInSurah":93,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فَنُزُلٌۭ مِّنْ حَمِيمٍۢ","translation":"তবে তার আপ্যায়ন হবে উত্তপ্ত পানি দ্বারা।","transliteration":"Fanuzulum min hameem"},{"number":5073,"numberInSurah":94,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"وَتَصْلِيَةُ جَحِيمٍ","translation":"এবং সে নিক্ষিপ্ত হবে অগ্নিতে।","transliteration":"Wa tasliyatu jaheem"},{"number":5074,"numberInSurah":95,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","translation":"এটা ধ্রুব সত্য।","transliteration":"Inna haaza lahuwa haqqul yaqeen"},{"number":5075,"numberInSurah":96,"juz":27,"page":537,"hizbQuarter":215,"sajda":false,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","translation":"অতএব, আপনি আপনার মহান পালনকর্তার নামে পবিত্রতা ঘোষণা করুন।","transliteration":"Fasabbih bismi rabbikal 'azeem"}]}