{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","banglaName":"আল-গাশিয়াহ","banglaTranslation":"আচ্ছন্নকারী মহা বিপদ","revelationType":"Meccan","ayahs":[{"number":5968,"numberInSurah":1,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","translation":"আপনার কাছে আচ্ছন্নকারী কেয়ামতের বৃত্তান্ত পৌঁছেছে কি?","transliteration":"Hal ataaka hadeesul ghaashiyah"},{"number":5969,"numberInSurah":2,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","translation":"অনেক মুখমন্ডল সেদিন হবে লাঞ্ছিত,","transliteration":"Wujoohuny yawma 'izin khaashi'ah"},{"number":5970,"numberInSurah":3,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"عَامِلَةٌۭ نَّاصِبَةٌۭ","translation":"ক্লিষ্ট, ক্লান্ত।","transliteration":"'Aamilatun naasibah"},{"number":5971,"numberInSurah":4,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"تَصْلَىٰ نَارًا حَامِيَةًۭ","translation":"তারা জ্বলন্ত আগুনে পতিত হবে।","transliteration":"Taslaa naaran haamiyah"},{"number":5972,"numberInSurah":5,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","translation":"তাদেরকে ফুটন্ত নহর থেকে পান করানো হবে।","transliteration":"Tusqaa min 'aynin aaniyah"},{"number":5973,"numberInSurah":6,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","translation":"কন্টকপূর্ণ ঝাড় ব্যতীত তাদের জন্যে কোন খাদ্য নেই।","transliteration":"Laisa lahum ta'aamun illaa min daree'"},{"number":5974,"numberInSurah":7,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","translation":"এটা তাদেরকে পুষ্ট করবে না এবং ক্ষুধায়ও উপকার করবে না।","transliteration":"Laa yusminu wa laa yughnee min joo'"},{"number":5975,"numberInSurah":8,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","translation":"অনেক মুখমন্ডল সেদিন হবে, সজীব,","transliteration":"Wujoohuny yawma 'izin naa'imah"},{"number":5976,"numberInSurah":9,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"لِّسَعْيِهَا رَاضِيَةٌۭ","translation":"তাদের কর্মের কারণে সন্তুষ্ট।","transliteration":"Lisa'yihaa raadiyah"},{"number":5977,"numberInSurah":10,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","translation":"তারা থাকবে, সুউচ্চ জান্নাতে।","transliteration":"Fee jannatin 'aaliyah"},{"number":5978,"numberInSurah":11,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","translation":"তথায় শুনবে না কোন অসার কথাবার্তা।","transliteration":"Laa tasma'u feehaa laaghiyah"},{"number":5979,"numberInSurah":12,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","translation":"তথায় থাকবে প্রবাহিত ঝরণা।","transliteration":"Feehaa 'aynun jaariyah"},{"number":5980,"numberInSurah":13,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","translation":"তথায় থাকবে উন্নত সুসজ্জিত আসন।","transliteration":"Feehaa sururum marfoo'ah"},{"number":5981,"numberInSurah":14,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","translation":"এবং সংরক্ষিত পানপাত্র","transliteration":"Wa akwaabum mawdoo 'ah"},{"number":5982,"numberInSurah":15,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وَنَمَارِقُ مَصْفُوفَةٌۭ","translation":"এবং সারি সারি গালিচা","transliteration":"Wa namaariqu masfoofah"},{"number":5983,"numberInSurah":16,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","translation":"এবং বিস্তৃত বিছানো কার্পেট।","transliteration":"Wa zaraabiyyu mabsoosah"},{"number":5984,"numberInSurah":17,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","translation":"তারা কি উষ্ট্রের প্রতি লক্ষ্য করে না যে, তা কিভাবে সৃষ্টি করা হয়েছে?","transliteration":"Afalaa yanzuroona ilalibili kaifa khuliqat"},{"number":5985,"numberInSurah":18,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","translation":"এবং আকাশের প্রতি লক্ষ্য করে না যে, তা কিভাবে উচ্চ করা হয়েছে?","transliteration":"Wa ilas samaaa'i kaifa rufi'at"},{"number":5986,"numberInSurah":19,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","translation":"এবং পাহাড়ের দিকে যে, তা কিভাবে স্থাপন করা হয়েছে?","transliteration":"Wa ilal jibaali kaifa nusibat"},{"number":5987,"numberInSurah":20,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","translation":"এবং পৃথিবীর দিকে যে, তা কিভাবে সমতল বিছানো হয়েছে?","transliteration":"Wa ilal ardi kaifa sutihat"},{"number":5988,"numberInSurah":21,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","translation":"অতএব, আপনি উপদেশ দিন, আপনি তো কেবল একজন উপদেশদাতা,","transliteration":"Fazakkir innama anta Muzakkir"},{"number":5989,"numberInSurah":22,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","translation":"আপনি তাদের শাসক নন,","transliteration":"Lasta 'alaihim bimusaitir"},{"number":5990,"numberInSurah":23,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","translation":"কিন্তু যে মুখ ফিরিয়ে নেয় ও কাফের হয়ে যায়,","transliteration":"Illaa man tawallaa wa kafar"},{"number":5991,"numberInSurah":24,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"فَيُعَذِّبُهُ ٱللَّ��ُ ٱلْعَذَابَ ٱلْأَكْبَرَ","translation":"আল্লাহ তাকে মহা আযাব দেবেন।","transliteration":"Fa yu'azzibuhul laahul 'azaabal akbar"},{"number":5992,"numberInSurah":25,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","translation":"নিশ্চয় তাদের প্রত্যাবর্তন আমারই নিকট,","transliteration":"Innaa ilainaaa iyaabahum"},{"number":5993,"numberInSurah":26,"juz":30,"page":592,"hizbQuarter":237,"sajda":false,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","translation":"অতঃপর তাদের হিসাব-নিকাশ আমারই দায়িত্ব।","transliteration":"Summa inna 'alainaa hisaabahum"}]}