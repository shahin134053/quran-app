rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: community_duas
    // Fields: text (string), authorName (string), authorUid (string), createdAt (timestamp), aminCount (number)
    //
    // Collection: leaderboard
    // Fields: userName (string), uid (string), score (number), updatedAt (timestamp)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.email == "shahin.prpl@gmail.com" ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isValidDua(data) {
      return data.text is string && data.text.size() > 0 && data.text.size() < 500 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() < 100 &&
             data.authorUid == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidScore(data) {
      return data.userName is string && data.userName.size() > 0 && data.userName.size() < 100 &&
             data.uid == request.auth.uid &&
             data.score is number &&
             data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() < 2000 &&
             data.createdAt is timestamp;
    }

    match /community_duas/{duaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidDua(request.resource.data);
      allow update: if isAuthenticated() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aminCount']) &&
                    request.resource.data.aminCount == resource.data.aminCount + 1;
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidScore(request.resource.data);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
