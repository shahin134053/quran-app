  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"import('node:fs').then(fs => { if(fs.existsSync('dist')){ fs.cpSync('dist','build',{recursive:true}); fs.cpSync('dist','out',{recursive:true}); } })\"",
    "start": "node server.ts",
