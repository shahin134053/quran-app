{
  "entities": {
    "duas": {
      "title": "Community Dua",
      "description": "User submitted prayer requests",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The prayer request text" },
        "authorName": { "type": "string", "description": "Name of the person requesting" },
        "authorUid": { "type": "string", "description": "UID of the author" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "aminCount": { "type": "number", "description": "Number of amins received" }
      },
      "required": ["text", "authorName", "authorUid", "createdAt"]
    },
    "quizScores": {
      "title": "Quiz Score",
      "description": "User quiz results for leaderboard",
      "type": "object",
      "properties": {
        "userName": { "type": "string", "description": "Name of the user" },
        "uid": { "type": "string", "description": "User UID" },
        "score": { "type": "number", "description": "Total score" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["userName", "uid", "score", "updatedAt"]
    },
    "appConfig": {
      "title": "App Configuration",
      "description": "Global settings and content managed by admin",
      "type": "object",
      "properties": {
        "homeAnnouncement": { "type": "string", "description": "Announcement shown on home screen" },
        "featuredDua": { "type": "string", "description": "A featured dua text" },
        "appStatus": { "type": "string", "description": "Current status of the app (e.g., online, maintenance)" },
        "donationBkash": { "type": "string", "description": "bKash donation number" },
        "donationNagad": { "type": "string", "description": "Nagad donation number" },
        "donationDBBLAccount": { "type": "string", "description": "DBBL donation account number" },
        "donationDBBLName": { "type": "string", "description": "DBBL donation account name" },
        "donationBankAsiaAccount": { "type": "string", "description": "Bank Asia donation account number" },
        "donationBankAsiaName": { "type": "string", "description": "Bank Asia donation account name" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      }
    },
    "announcements": {
      "title": "Announcements",
      "description": "Admin announcements for users",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the announcement" },
        "message": { "type": "string", "description": "Content of the announcement" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["title", "message", "createdAt"]
    }
  },
  "firestore": {
    "/community_duas/{duaId}": {
      "schema": "duas",
      "description": "Collection of community prayer requests"
    },
    "/leaderboard/{userId}": {
      "schema": "quizScores",
      "description": "User scores for the global leaderboard"
    },
    "/app_config/{configId}": {
      "schema": "appConfig",
      "description": "Global app configuration settings"
    },
    "/announcements/{announcementId}": {
      "schema": "announcements",
      "description": "Collection of admin announcements"
    }
  }
}
